---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Gracias por tu opinión" description="Ya tengo tu opinión." noindex={true}>
  <section class="gracias">
    <div class="container">
      <div class="gracias__content">
        <h1>¡Gracias!</h1>
        <p class="gracias__message">Ya tengo tu opinión y la leeré con calma. Saber cómo os ha ido me ayuda a seguir mejorando para otras familias.</p>
        <a href="/" class="btn btn--secondary">Volver al inicio</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gracias {
    padding: var(--spacing-xl) 0;
  }

  .gracias__content {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .gracias__content h1 {
    margin-bottom: var(--spacing-md);
  }

  .gracias__message {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    margin-bottom: var(--spacing-lg);
    line-height: 1.6;
  }
</style>
