---
import Layout from '../layouts/Layout.astro';
import { CONSULTATIONS_ENABLED } from '../data/consultas';
import { GUIDES_ENABLED } from '../data/guias';
---

<Layout title="Contacto" description="Contacta con Mar, enfermera infantil. Estoy aquí para ayudarte con lo que necesites.">
  <section class="contacto">
    <div class="container">
      <header class="page-header">
        <h1>Contacto</h1>
        <p class="page-header__subtitle">Estoy aquí. Cuéntame qué necesitas.</p>
      </header>

      <div class="contacto__orientacion">
        <div class="contacto__orientacion-item">
          <h2>¿Necesitas ayuda con tu&nbsp;hijo/a?</h2>
          <p>
            {CONSULTATIONS_ENABLED
              ? 'Mira mis consultas y decide qué opción puede encajar mejor contigo.'
              : 'Muy pronto podrás reservar una consulta por correo o por videollamada. Mira qué opciones tendrás.'}
          </p>
          <a href="/consultas" class="btn btn--primary">
            Ver mis consultas <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="contacto__orientacion-item">
          <h2>¿No sabes qué escoger?</h2>
          <p>
            {GUIDES_ENABLED
              ? 'Si no sabes dónde encaja tu duda, qué guía comprar o simplemente necesitas aclararte: escríbeme y te indicaré por dónde empezar.'
              : 'Si no sabes dónde encaja tu duda o simplemente necesitas aclararte: escríbeme y te indicaré por dónde empezar.'}
          </p>
          <a href="?motivo=orientacion#formulario" class="btn btn--secondary">
            Escribirme <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div id="formulario" class="contacto__form-wrapper">
        <div class="contacto__form">
          <h2>Escríbeme</h2>
          <p class="contacto__form-desc">Para orientarte sobre qué consulta elegir, colaboraciones, problemas con una compra o cualquier otra cosa. Te respondo en 24–48 horas laborables.</p>
          <p class="contacto__form-warning">No lo utilices para urgencias ni envíes datos de salud o imágenes de tu hijo o hija: para eso están las consultas.</p>
          <form
            name="contacto"
            method="POST"
            action="/api/contact"
            class="form"
            data-friendly-validation
            novalidate
          >
            <!-- Honeypot anti-spam (oculto para usuarios, visible para bots) -->
            <div class="form__honeypot" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form__group" data-validation-field>
              <label for="motivo">Motivo</label>
              <select id="motivo" name="motivo" required data-error-required="Elige el motivo de tu mensaje.">
                <option value="" disabled selected>Elige una opción</option>
                <option value="orientacion">No sé qué consulta elegir</option>
                <option value="colaboracion">Colaboración o prensa</option>
                <option value="compra">Problema con una compra</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="form__group" data-validation-field>
              <label for="nombre">Nombre</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required data-error-required="Cuéntame cómo te llamas." />
            </div>

            <div class="form__group" data-validation-field>
              <label for="email">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="tu@email.com"
                required
                data-error-required="Escribe tu correo para que pueda responderte."
                data-error-invalid="Revisa el correo. Debe tener un formato como nombre@correo.com."
              />
            </div>

            <div class="form__group" data-validation-field>
              <label for="mensaje">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="5" placeholder="¿En qué puedo ayudarte?" required data-error-required="Cuéntame en qué puedo ayudarte."></textarea>
            </div>

            <p class="form__privacy"><strong>Privacidad:</strong> Piel de Pomelo SLP usará tus datos para responder a tu solicitud. Puedes ejercer tus derechos y consultar destinatarios, conservación y demás información en la <a href="/proteccion-datos" target="_blank" rel="noopener">política de privacidad</a>.</p>

            <button type="submit" class="btn btn--primary btn--full">
              Enviar mensaje
            </button>
          </form>
        </div>
        <p class="contacto__alt">¿Prefieres el email? <a href="mailto:hola@pomelobaby.es">hola@pomelobaby.es</a></p>
      </div>

      <p class="contacto__instagram">¿Solo quieres saludar? ¡Me encanta conoceros! Me encontrarás en Instagram: <a href="https://instagram.com/pomelo.bby" target="_blank" rel="noopener noreferrer">@pomelo.bby</a></p>
    </div>
  </section>
</Layout>

<script>
  const motivo = new URLSearchParams(window.location.search).get('motivo');
  const select = document.querySelector<HTMLSelectElement>('#motivo');
  if (select && motivo && Array.from(select.options).some((option) => option.value === motivo)) {
    select.value = motivo;
  }
</script>

<style>
  .contacto {
    padding: var(--spacing-xl) 0;
  }

  .contacto__orientacion {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 760px;
    margin: 0 auto var(--spacing-xl);
  }

  .contacto__orientacion-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-lg);
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    text-align: center;
  }

  .contacto__orientacion-item p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--spacing-sm);
  }

  .contacto__orientacion-item h2 {
    margin-bottom: var(--spacing-sm);
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .contacto__orientacion-item .btn {
    margin-top: auto;
  }

  .contacto__orientacion-item p:last-of-type {
    margin-bottom: var(--spacing-md);
  }

  .contacto__form-wrapper {
    max-width: 550px;
    margin: 0 auto;
    scroll-margin-top: 6rem;
  }

  .contacto__form {
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: var(--spacing-lg);
  }

  .contacto__form h2 {
    margin-bottom: var(--spacing-xs);
    font-size: 1.5rem;
  }

  .contacto__form-desc {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--spacing-sm);
    line-height: 1.5;
  }

  .contacto__form-warning {
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.5;
    background-color: var(--color-nude);
    border-radius: var(--radius-sm);
  }

  .contacto__alt,
  .contacto__instagram {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .contacto__alt {
    margin: var(--spacing-md) 0 0;
  }

  .contacto__instagram {
    max-width: 550px;
    margin: var(--spacing-xl) auto 0;
  }

  .contacto__alt a,
  .contacto__instagram a {
    color: var(--color-coral-hover);
    font-weight: 700;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form__group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form__group label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .form__privacy {
    color: var(--color-text-tertiary);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .form__privacy a {
    text-decoration: underline;
  }

  .form__group input,
  .form__group select,
  .form__group textarea {
    font-family: var(--font-family);
    font-size: 0.95rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    color: var(--color-text);
    transition: border-color 0.2s ease;
    resize: vertical;
  }

  .form__group input:focus,
  .form__group select:focus,
  .form__group textarea:focus {
    border-color: var(--color-coral-hover);
  }

  .form__group input::placeholder,
  .form__group textarea::placeholder {
    color: var(--color-text-tertiary);
  }

  .form__group select:invalid {
    color: var(--color-text-tertiary);
  }

  .form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .contacto__orientacion {
      grid-template-columns: 1fr;
      max-width: 550px;
    }
  }
</style>
