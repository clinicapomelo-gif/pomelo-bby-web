---
import PhonePrefix from '../components/PhonePrefix.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto" description="Contacta con Mar, enfermera infantil. Estoy aquí para ayudarte con lo que necesites.">
  <section class="contacto">
    <div class="container">
      <header class="page-header">
        <h1>Contacto</h1>
        <p class="page-header__subtitle">Estoy aquí. Cuéntame qué necesitas.</p>
      </header>

      <div class="contacto__caminos">
        <article class="contacto__camino">
          <span class="contacto__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></svg>
          </span>
          <h2>¿Quieres conocerme un poquito más?</h2>
          <p>Sígueme en Instagram y acompáñame en el día a día de Pomelo&nbsp;Baby: salud infantil, crianza real y mucho menos ruido.</p>
          <a href="https://instagram.com/pomelo.bby" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            Ir a Instagram <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="contacto__camino">
          <span class="contacto__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.6-.8L3 21l1.9-5.3A8.4 8.4 0 1 1 21 11.5Z" /></svg>
          </span>
          <h2>¿Necesitas una consulta?</h2>
          <p>Si quieres que revisemos juntos tus dudas y encontremos respuestas adaptadas a vuestra situación, aquí puedes ver las consultas disponibles.</p>
          <a href="/consultas" class="btn btn--primary">
            Ver consultas <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>

      <div id="formulario" class="contacto__form-wrapper">
        <div class="contacto__form">
          <h2>¿Necesitas ponerte en contacto conmigo?</h2>
          <p id="contacto-error" class="contacto__error" role="alert" tabindex="-1" hidden>
            No hemos podido enviar tu mensaje. Inténtalo de nuevo en unos minutos o escríbenos a <a href="mailto:hola@pomelobaby.es">hola@pomelobaby.es</a>.
          </p>
          <p class="contacto__form-desc">Si no sabes qué consulta elegir, tienes una colaboración, un problema con una compra o cualquier otra cosa: escríbeme. Te respondo en 24–48 horas laborables.</p>
          <p class="contacto__form-warning">No lo utilices para urgencias ni envíes datos de salud o imágenes de tu hijo o hija.</p>
          <form
            name="contacto"
            method="POST"
            action="/api/contact"
            class="form"
            data-friendly-validation
            novalidate
          >
            <!-- Honeypot anti-spam (oculto para usuarios, visible para bots) -->
            <div class="form__honeypot" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form__group" data-validation-field>
              <label for="motivo">Motivo</label>
              <select id="motivo" name="motivo" required data-error-required="Elige el motivo de tu mensaje.">
                <option value="" disabled selected>Elige una opción</option>
                <option value="orientacion">No sé qué consulta elegir</option>
                <option value="colaboracion">Colaboración o prensa</option>
                <option value="compra">Problema con una compra</option>
                <option value="horario">Otro horario para una consulta</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="form__group" data-validation-field>
              <label for="nombre">Nombre</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required data-error-required="Cuéntame cómo te llamas." />
            </div>

            <div class="form__group" data-validation-field>
              <label for="email">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="tu@email.com"
                required
                data-error-required="Escribe tu correo para que pueda responderte."
                data-error-invalid="Revisa el correo. Debe tener un formato como nombre@correo.com."
              />
            </div>

            <div class="form__group" data-validation-field>
              <label for="telefono">Teléfono de contacto <span>(opcional)</span></label>
              <div class="phone">
              <PhonePrefix />
              <input type="tel" id="telefono" name="telefono" inputmode="tel" autocomplete="tel-national" maxlength="20" placeholder="612 345 678" data-phone aria-describedby="telefono-ayuda" />
            </div>
              <small id="telefono-ayuda">Si lo dejas, puedo escribirte por WhatsApp cuando sea más fácil aclarar algo. Si no, te respondo por email.</small>
            </div>

            <div id="campos-horario" hidden>
              <div class="form__group" data-validation-field>
                <label for="consulta">Consulta que quiero</label>
                <select id="consulta" name="consulta" disabled data-error-required="Elige la consulta que quieres.">
                  <option value="" disabled selected>Elige una opción</option>
                  <option value="calma">Necesito hablar con calma</option>
                  <option value="plan">Necesito un plan</option>
                </select>
              </div>

              <fieldset class="chips" data-validation-field>
                <legend>Días que me vienen bien</legend>
                <div class="chips__list chips__list--dias">
                  <label class="chip"><input type="checkbox" name="dias" value="lunes" disabled data-error-required="Marca al menos un día." /><span>Lun</span></label>
                  <label class="chip"><input type="checkbox" name="dias" value="martes" disabled /><span>Mar</span></label>
                  <label class="chip"><input type="checkbox" name="dias" value="miércoles" disabled /><span>Mié</span></label>
                  <label class="chip"><input type="checkbox" name="dias" value="jueves" disabled /><span>Jue</span></label>
                  <label class="chip"><input type="checkbox" name="dias" value="viernes" disabled /><span>Vie</span></label>
                </div>
              </fieldset>

              <fieldset class="chips" data-validation-field>
                <legend>Franja</legend>
                <div class="chips__list">
                  <label class="chip"><input type="radio" name="franja" value="manana" disabled data-error-required="Elige una franja." /><span>Mañana</span></label>
                  <label class="chip"><input type="radio" name="franja" value="tarde" disabled /><span>Tarde</span></label>
                  <label class="chip"><input type="radio" name="franja" value="igual" disabled /><span>Me da igual</span></label>
                </div>
              </fieldset>

              <div class="form__group">
                <label for="notas">Hora concreta u otra cosa sobre horarios <span>(opcional)</span></label>
                <textarea id="notas" name="notas" rows="3" maxlength="300" disabled placeholder="Por ejemplo: a partir de las 18:30"></textarea>
              </div>

              <div class="horario-pasos">
                <p class="horario-pasos__titulo">Cómo funciona</p>
                <ol>
                  <li>Me cuentas qué horario te encaja.</li>
                  <li>Te respondo con las horas disponibles en cuanto pueda.</li>
                  <li>Reservas y pagas en ese momento.</li>
                </ol>
              </div>
            </div>

            <div id="campos-mensaje" class="form__group" data-validation-field>
              <label for="mensaje">¿En qué puedo ayudarte?</label>
              <textarea id="mensaje" name="mensaje" rows="5" required data-error-required="Cuéntame en qué puedo ayudarte."></textarea>
            </div>

            <p class="form__privacy"><strong>Privacidad:</strong> Piel de Pomelo S.L.P usará tus datos para responder a tu solicitud. Puedes ejercer tus derechos y consultar destinatarios, conservación y demás información en la <a href="/proteccion-datos" target="_blank" rel="noopener">política de privacidad</a>.</p>

            <button type="submit" class="btn btn--primary btn--full">
              Enviar mensaje <span aria-hidden="true">→</span>
            </button>
          </form>
        </div>
        <p class="contacto__alt">¿Prefieres el email? <a href="mailto:hola@pomelobaby.es">hola@pomelobaby.es</a></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../lib/phone-field.ts';
  const params = new URLSearchParams(window.location.search);
  const motivo = params.get('motivo');
  const select = document.querySelector<HTMLSelectElement>('#motivo');
  if (select && motivo && Array.from(select.options).some((option) => option.value === motivo)) {
    select.value = motivo;
  }

  // «Otro horario» pide la consulta, los días, la franja y unas notas en campos propios en
  // lugar del mensaje libre. Los campos del bloque oculto se desactivan para que no se
  // envíen ni se validen.
  const camposHorario = document.querySelector<HTMLElement>('#campos-horario');
  const camposMensaje = document.querySelector<HTMLElement>('#campos-mensaje');
  const dias = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="dias"]'));
  const franjas = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="franja"]'));
  // Un grupo de casillas no tiene «al menos una» nativo: mientras no haya ninguna marcada,
  // la primera es obligatoria.
  const exigirUnDia = () => {
    dias.forEach((dia, i) => { dia.required = !dia.disabled && i === 0 && !dias.some((d) => d.checked); });
  };
  const mostrarCampos = () => {
    if (!select || !camposHorario || !camposMensaje) return;
    const horario = select.value === 'horario';
    camposHorario.hidden = !horario;
    camposMensaje.hidden = horario;
    camposHorario.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => {
      field.disabled = !horario;
      field.required = false;
    });
    camposHorario.querySelector<HTMLSelectElement>('#consulta')!.required = horario;
    franjas[0].required = horario;
    exigirUnDia();
    const mensaje = camposMensaje.querySelector<HTMLTextAreaElement>('textarea');
    if (mensaje) {
      mensaje.disabled = horario;
      mensaje.required = !horario;
    }
  };
  select?.addEventListener('change', mostrarCampos);
  dias.forEach((dia) => dia.addEventListener('change', exigirUnDia));
  mostrarCampos();

  const error = document.querySelector<HTMLElement>('#contacto-error');
  if (error && params.has('error')) {
    error.hidden = false;
    error.focus();
    params.delete('error');
    const query = params.toString();
    history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`);
  }
</script>

<style>
  .contacto {
    padding: var(--spacing-xl) 0;
  }

  .contacto__caminos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 760px;
    margin: 0 auto var(--spacing-xl);
  }

  .contacto__camino {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
  }

  .contacto__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: var(--spacing-lg);
    border-radius: 50%;
    background-color: var(--color-nude);
    color: var(--color-coral-hover);
  }

  .contacto__camino h2 {
    margin-bottom: var(--spacing-sm);
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .contacto__camino p {
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .contacto__camino .btn {
    width: 100%;
    margin-top: auto;
  }

  .contacto__form-wrapper {
    max-width: 600px;
    margin: 0 auto;
    scroll-margin-top: 6rem;
  }

  .contacto__form {
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .contacto__form h2 {
    margin-bottom: var(--spacing-xs);
    font-size: 1.5rem;
  }

  .contacto__form-desc {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--spacing-sm);
    line-height: 1.5;
  }

  .contacto__error {
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.5;
    background-color: var(--color-nude);
    border-left: 3px solid var(--color-coral-hover);
    border-radius: var(--radius-sm);
  }

  .contacto__error a {
    color: var(--color-coral-hover);
    font-weight: 600;
  }

  .contacto__form-warning {
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.5;
    background-color: var(--color-nude);
    border-radius: var(--radius-sm);
  }

  .contacto__alt {
    margin: var(--spacing-md) 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .contacto__alt a {
    color: var(--color-coral-hover);
    font-weight: 700;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form__group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form__group[hidden] {
    display: none;
  }

  #campos-horario:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .chips {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .chips legend {
    padding: 0;
    margin-bottom: var(--spacing-sm);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .chips__list--dias {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .chips__list--dias .chip span {
    min-width: 0;
    padding: 0 0.25rem;
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .chips__list--dias .chip input:checked + span::before {
      content: none;
    }
  }

  .chip {
    position: relative;
    display: inline-flex;
  }

  .chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 3.5rem;
    min-height: 44px;
    padding: 0 var(--spacing-md);
    border: 1.5px solid var(--color-peach);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .chip input:checked + span {
    border-color: var(--color-coral-hover);
    background-color: var(--color-nude);
    color: var(--color-coral-hover);
    font-weight: 600;
  }

  .chip input:checked + span::before {
    content: '✓';
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--color-coral-hover);
    outline-offset: 2px;
  }

  [data-validation-field].is-invalid .chip span {
    border-color: var(--color-coral-hover);
  }

  .horario-pasos {
    padding: var(--spacing-md);
    background-color: var(--color-nude);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .horario-pasos__titulo {
    margin: 0 0 var(--spacing-xs);
    color: var(--color-text);
    font-weight: 600;
  }

  .horario-pasos ol {
    margin: 0;
    padding-left: 1.25rem;
  }

  .form__group label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .form__group label span,
  .form__group small {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .form__privacy {
    color: var(--color-text-tertiary);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .form__privacy a {
    text-decoration: underline;
  }

  .form__group input,
  .form__group select,
  .form__group textarea {
    font-family: var(--font-family);
    font-size: 0.95rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    color: var(--color-text);
    transition: border-color 0.2s ease;
    resize: vertical;
  }

  .form__group input:focus,
  .form__group select:focus,
  .form__group textarea:focus {
    border-color: var(--color-coral-hover);
  }

  .form__group input::placeholder,
  .form__group textarea::placeholder {
    color: var(--color-text-tertiary);
  }

  .form__group select:invalid {
    color: var(--color-text-tertiary);
  }

  .form__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .contacto__caminos {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }
</style>
