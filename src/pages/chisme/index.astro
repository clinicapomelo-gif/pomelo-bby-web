---
import Layout from '../../layouts/Layout.astro';
import LeadMagnetForm from '../../components/LeadMagnetForm.astro';
import { CHISME_ENABLED } from '../../data/chisme';

const description = CHISME_ENABLED
  ? 'Historias reales, información clara y crianza sin ruido. Únete al email quincenal de Mar y recibe gratis la guía 25 cosas normales en los bebés.'
  : 'El Chisme de Mar estará disponible próximamente: historias reales, información clara y crianza sin ruido.';
---

<Layout title="El Chisme de Mar" description={description}>
  <section class="newsletter-about" aria-labelledby="newsletter-about-title">
    <div class="container">
      <div class="newsletter-about__card">
        <header class="newsletter-about__header">
          <p class="newsletter-about__eyebrow">{CHISME_ENABLED ? 'Cada quince días en tu correo' : 'Próximamente'}</p>
          <h1 id="newsletter-about-title">El Chisme de&nbsp;Mar</h1>
        </header>

        <div>
          <p class="newsletter-about__intro">Porque hay cosas que no caben en un post de Instagram.</p>
          <p>Aquí te cuento historias que me han pasado trabajando con niños y familias, cosas que he aprendido por el camino, situaciones que me han hecho pensar y alguna que otra opinión que quizá no sea la más popular.</p>
          <p>Sin postureo. Sin recetas mágicas. Y sin convertir la crianza en una película de terror.</p>

          <ul>
            <li>Historias que te harán pensar.</li>
            <li>Cosas que quizá nadie te había contado así.</li>
            <li>Una mirada de enfermera, pero hablando como una persona normal.</li>
          </ul>
        </div>

        <div class="newsletter-about__trust">
          <div class="newsletter-about__author">
            <img src="/mar-inicio.webp" alt="" width="1200" height="1601" loading="eager" decoding="async" />
            <p><strong>Escrito por Mar</strong><span>Enfermera infantil y neonatal · Colegiada n.º&nbsp;16700</span></p>
          </div>
          <blockquote class="newsletter-about__quote">«Aquí no vengo a decirte cómo tienes que criar. Vengo a contarte lo que he visto, lo que he aprendido y lo que sigo aprendiendo cada día.»</blockquote>
          <p>Las historias profesionales se cuentan de forma anonimizada y sin datos que permitan identificar a ninguna familia.</p>
        </div>
      </div>
    </div>
  </section>

  <LeadMagnetForm eyebrow="Regalo de bienvenida" compact />
</Layout>

<style>
  .newsletter-about {
    padding: var(--spacing-xl) 0 0;
    background-color: var(--color-white);
  }

  :where(.newsletter-about p, .newsletter-about li) {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .newsletter-about__card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: 0 var(--spacing-xl);
    max-width: 900px;
    margin: 0 auto;
    padding: var(--spacing-xl);
    background-color: var(--color-nude);
    border-radius: var(--radius-md);
  }

  .newsletter-about__header {
    grid-column: 1 / -1;
  }

  .newsletter-about__eyebrow {
    margin-bottom: var(--spacing-sm);
    color: var(--color-coral-hover);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .newsletter-about h1 {
    margin-bottom: var(--spacing-sm);
  }

  .newsletter-about__intro {
    color: var(--color-text);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .newsletter-about ul {
    display: grid;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .newsletter-about li {
    position: relative;
    padding-left: 1.5rem;
  }

  .newsletter-about li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-coral-text);
    font-weight: 700;
  }

  .newsletter-about__trust {
    align-self: start;
    padding-left: var(--spacing-lg);
    border-left: 1px solid var(--color-peach);
  }

  .newsletter-about__author {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .newsletter-about__author img {
    width: 3.75rem;
    height: 3.75rem;
    flex: 0 0 auto;
    border: 2px solid var(--color-peach);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 24%;
  }

  .newsletter-about__author p {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .newsletter-about__author strong {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .newsletter-about__author span,
  .newsletter-about__trust > p {
    font-size: 0.78rem;
  }

  .newsletter-about__quote {
    margin: 0 0 var(--spacing-md);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .newsletter-about__card {
      grid-template-columns: 1fr;
      padding: var(--spacing-lg);
    }

    .newsletter-about__trust {
      margin-top: var(--spacing-lg);
      padding: var(--spacing-lg) 0 0;
      border-top: 1px solid var(--color-peach);
      border-left: 0;
    }
  }
</style>
