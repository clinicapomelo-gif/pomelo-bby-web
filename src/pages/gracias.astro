---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mensaje enviado" description="Gracias por tu mensaje. Mar te responderá pronto.">
  <section class="gracias">
    <div class="container">
      <div class="gracias__content">
        <p class="gracias__icon">🤍</p>
        <h1>Mensaje enviado</h1>
        <p>Gracias por escribirme. Te responderé lo antes posible.</p>
        <a href="/" class="btn btn--primary">Volver al inicio</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gracias {
    padding: var(--spacing-xl) 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .gracias__content {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .gracias__icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-md);
  }

  .gracias__content h1 {
    margin-bottom: var(--spacing-md);
  }

  .gracias__content p {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    background-color: var(--color-coral);
    color: var(--color-white);
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: var(--color-coral-hover);
    color: var(--color-white);
  }
</style>
