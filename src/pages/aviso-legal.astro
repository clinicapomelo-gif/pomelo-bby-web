---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Aviso legal" description="Aviso legal de pomelo.bby">
  <section class="legal">
    <div class="container">
      <h1>Aviso legal</h1>
      <p class="legal__placeholder">
        Este contenido está pendiente de redacción por parte de un profesional legal.
        Si tienes alguna pregunta, contacta con nosotros en <a href="mailto:hola@pomelobby.com">hola@pomelobby.com</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal {
    padding: var(--spacing-xl) 0;
    max-width: 700px;
  }

  .legal h1 {
    margin-bottom: var(--spacing-lg);
  }

  .legal__placeholder {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
</style>
