---
import Layout from '../../layouts/Layout.astro';

const guiaId = Astro.url.searchParams.get('guia');
const sessionId = Astro.url.searchParams.get('session_id');
---

<Layout title="Compra completada" description="Gracias por tu compra. Tu guía está lista para descargar.">
  <section class="gracias">
    <div class="container">
      <div class="gracias__content">
        <p class="gracias__icon">🎉</p>
        <h1>Compra completada</h1>
        <p>Gracias por tu compra. En breve recibirás un email con el enlace de descarga de tu guía.</p>
        <p class="gracias__note">Si no recibes el email en los próximos minutos, revisa la carpeta de spam o <a href="/contacto">contáctame</a>.</p>
        <a href="/tienda" class="btn btn--primary">Ver más guías</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gracias {
    padding: var(--spacing-xl) 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .gracias__content {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
  }

  .gracias__icon {
    font-size: 3rem;
    margin: 0;
  }

  .gracias__content h1 {
    margin: 0;
  }

  .gracias__content p {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .gracias__note {
    font-size: 0.9rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    background-color: var(--color-coral);
    color: var(--color-white);
    transition: background-color 0.2s ease;
    margin-top: var(--spacing-sm);
  }

  .btn:hover {
    background-color: var(--color-coral-hover);
    color: var(--color-white);
  }
</style>
