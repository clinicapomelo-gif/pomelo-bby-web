---
import Layout from '../../layouts/Layout.astro';

const guiaId = Astro.url.searchParams.get('guia');
const sessionId = Astro.url.searchParams.get('session_id');
---

<Layout title="Compra completada" description="Gracias por tu compra. Tu guía está lista.">
  <section class="gracias">
    <div class="container">
      <div class="gracias__content">
        <p class="gracias__icon">🎉</p>
        <h1>¡Listo!</h1>
        <p>Gracias por tu compra. En unos minutos recibirás un email con el enlace para descargar tu guía.</p>
        <p class="gracias__note">Si no lo ves, revisa la carpeta de spam. Y si sigue sin aparecer, <a href="/contacto">escríbeme</a> y lo solucionamos.</p>
        <a href="/tienda" class="btn btn--primary">Ver más guías</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gracias {
    padding: var(--spacing-xl) 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .gracias__content {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
  }

  .gracias__icon {
    font-size: 3rem;
    margin: 0;
  }

  .gracias__content h1 {
    margin: 0;
  }

  .gracias__content p {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .gracias__note {
    font-size: 0.9rem;
  }

  .gracias__content .btn {
    margin-top: var(--spacing-sm);
  }
</style>
