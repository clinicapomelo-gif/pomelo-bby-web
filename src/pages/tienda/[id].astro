---
import Layout from '../../layouts/Layout.astro';
import { formatGuiaPrice, guias, isGuiaPurchasable } from '../../data/guias';

export function getStaticPaths() {
  return guias.map((guia) => ({
    params: { id: guia.id },
    props: { guia },
  }));
}

const { guia } = Astro.props;
const canCheckout = isGuiaPurchasable(guia);
---

<Layout title={guia.title} description={guia.description}>
  <section class="producto">
    <div class="container">
      <a href="/tienda" class="producto__back">← Volver a guías</a>

      <div class="producto__grid">
        <div class="producto__info">
          <span class="producto__category">{guia.category}</span>
          <h1 class="producto__title">{guia.title}</h1>
          <p class="producto__description">{guia.description}</p>

          <div class="producto__disclaimer">
            <p>Este recurso es orientativo y no sustituye la valoración de un profesional sanitario.</p>
          </div>
        </div>

        <div class="producto__compra">
          <div class="producto__card">
            <p class="producto__precio">{formatGuiaPrice(guia.price)}</p>

            {guia.status === 'free' && (
              <div class="producto__action">
                <p class="producto__entrega">Un recurso gratuito para acompañarte con información clara.</p>
                <a href={guia.leadMagnetUrl} class="btn btn--primary btn--full">Recibir la guía gratis</a>
              </div>
            )}

            {canCheckout && (
              <div class="producto__action">
                <p class="producto__entrega">Recibirás por email un enlace de descarga disponible durante 30 días.</p>
                <form id="checkout-form" method="POST" action="/api/checkout">
                  <input type="hidden" name="guiaId" value={guia.id} />
                  <button id="btn-comprar" type="submit" class="btn btn--primary btn--full">
                    Comprar ahora
                  </button>
                </form>
                <ul class="producto__garantias">
                  <li>✓ Pago seguro con Stripe</li>
                  <li>✓ Descarga en PDF</li>
                  <li>✓ Si pierdes el enlace, escríbeme y revisamos tu compra</li>
                </ul>
              </div>
            )}

            {guia.status !== 'free' && !canCheckout && (
              <div class="producto__action">
                <p class="producto__entrega">Esta guía todavía se está preparando.</p>
                <span class="btn btn--disabled btn--full" aria-disabled="true">Próximamente</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#checkout-form');
  const button = document.querySelector<HTMLButtonElement>('#btn-comprar');

  if (form && button) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.textContent = 'Redirigiendo...';
      button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();

        if (response.ok && data.url) {
          window.location.href = data.url;
          return;
        }

        throw new Error(data.error || 'No se pudo iniciar el pago.');
      } catch (error) {
        button.textContent = 'Comprar ahora';
        button.disabled = false;
        alert(error instanceof Error ? error.message : 'Ha ocurrido un error. Por favor, inténtalo de nuevo.');
      }
    });
  }
</script>

<style>
  .producto {
    padding: var(--spacing-xl) 0;
  }

  .producto__back {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
    transition: color 0.2s ease;
  }

  .producto__back:hover {
    color: var(--color-coral);
  }

  .producto__grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .producto__category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-coral);
    background-color: var(--color-peach);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: var(--spacing-md);
  }

  .producto__title {
    font-size: 2rem;
    line-height: 1.25;
    margin-bottom: var(--spacing-md);
  }

  .producto__description {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-lg);
  }

  .producto__disclaimer {
    padding: var(--spacing-md);
    background-color: var(--color-nude);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-coral);
  }

  .producto__disclaimer p {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Card de compra */
  .producto__card {
    position: sticky;
    top: 100px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .producto__precio {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .producto__action {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .producto__entrega {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .btn--disabled {
    background-color: var(--color-border);
    color: var(--color-text-secondary);
    cursor: not-allowed;
  }

  .producto__garantias {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .producto__garantias li {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1024px) {
    .producto__grid {
      grid-template-columns: 1fr;
    }

    .producto__card {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .producto__title {
      font-size: 1.6rem;
    }
  }
</style>
