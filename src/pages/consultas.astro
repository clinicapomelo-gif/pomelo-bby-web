---
import Layout from '../layouts/Layout.astro';

// TODO: Cambiar por el username y slugs reales de Cal.com
const CAL_USERNAME = 'pomelo-bby'; // tu username de Cal.com
const CAL_EXPRESS_SLUG = 'consulta-express'; // slug del event type express
const CAL_PERSONALIZADA_SLUG = 'consulta-personalizada'; // slug del event type personalizada
---

<Layout title="Consultas" description="Consultas de enfermería infantil con Mar. Resuelve tus dudas de crianza y alimentación con acompañamiento profesional.">
  <section class="consultas">
    <div class="container">
      <div class="consultas__intro">
        <h1>Consultas</h1>
        <p class="consultas__subtitle">Un espacio para ti, sin prisas. Hablamos de lo que te preocupa y salimos con un plan.</p>
        <p class="consultas__desc">Porque a veces simplemente necesitas alguien que te escuche, te comprenda y te diga que lo estás haciendo mejor de lo que crees.</p>
      </div>

      <div class="consultas__grid">

        <!-- Tier 1: Duda por mensaje -->
        <div class="consulta-card">
          <div class="consulta-card__header">
            <span class="consulta-card__badge">💌 Por mensaje</span>
            <h2>Duda por mensaje</h2>
            <p class="consulta-card__tagline">Para una duda puntual que puedas explicarme por escrito.</p>
          </div>
          <div class="consulta-card__pricing">
            <p class="consulta-card__price">19€</p>
          </div>
          <div class="consulta-card__examples">
            <p class="consulta-card__examples-label">Consultas frecuentes</p>
            <ul>
              <li>¿Esta caca es normal?</li>
              <li>¿Puede ser una crisis de sueño?</li>
              <li>¿Qué crema o protector solar le compro?</li>
              <li>¿Debo preocuparme por estos mocos?</li>
              <li>¿Esta herida está cicatrizando bien?</li>
              <li>¿Es normal esto o voy al pediatra?</li>
            </ul>
          </div>
          <ul class="consulta-card__checklist">
            <li class="checklist--yes">Resolver una duda concreta por chat</li>
            <li class="checklist--yes">Respuesta personalizada</li>
            <li class="checklist--yes">Posibilidad de enviar contexto, fotos o vídeos</li>
            <li class="checklist--yes">Ideal para dudas que no necesitan videollamada</li>
            <li class="checklist--no">Seguimiento prolongado</li>
          </ul>
          <div class="consulta-card__footer">
            <button class="btn btn--primary" id="btn-consulta-mensaje">Consultar por mensaje</button>
          </div>
        </div>

        <!-- Tier 2: Consulta rápida -->
        <div class="consulta-card">
          <div class="consulta-card__header">
            <span class="consulta-card__badge">🎥 Express</span>
            <h2>Consulta rápida</h2>
            <p class="consulta-card__tagline">Para un problema concreto que necesita contexto y preguntas para poder ayudarte.</p>
          </div>
          <div class="consulta-card__pricing">
            <p class="consulta-card__price">35€</p>
          </div>
          <div class="consulta-card__examples">
            <p class="consulta-card__examples-label">Consultas frecuentes</p>
            <ul>
              <li>Mi bebé se despierta muchas veces por la noche.</li>
              <li>Voy a empezar alimentación complementaria y tengo dudas.</li>
              <li>Quiero retirar el chupete.</li>
              <li>Quiero retirar el pañal.</li>
              <li>Mi hijo tiene rabietas y no sé cómo gestionarlas.</li>
              <li>Me han dado recomendaciones contradictorias y estoy confundida.</li>
            </ul>
          </div>
          <ul class="consulta-card__checklist">
            <li class="checklist--yes">Videollamada 15-20 min</li>
            <li class="checklist--yes">Una duda concreta</li>
            <li class="checklist--yes">Orientación clara y práctica</li>
            <li class="checklist--yes">Ideal para salir de dudas rápido</li>
            <li class="checklist--no">Seguimiento</li>
            <li class="checklist--no">Resumen escrito</li>
            <li class="checklist--no">Plan personalizado</li>
          </ul>
          <div class="consulta-card__footer">
            <button data-cal-link={`${CAL_USERNAME}/${CAL_EXPRESS_SLUG}`} data-cal-config='{"layout":"month_view"}' class="btn btn--primary">Reservar duda rápida</button>
          </div>
        </div>

        <!-- Tier 3: Consulta completa (ESTRELLA) -->
        <div class="consulta-card consulta-card--featured">
          <div class="consulta-card__header">
            <span class="consulta-card__badge consulta-card__badge--featured">❤️ Más popular</span>
            <h2>Consulta completa</h2>
            <p class="consulta-card__tagline">Para situaciones que están afectando a vuestro día a día y necesitan una valoración global.</p>
          </div>
          <div class="consulta-card__pricing">
            <p class="consulta-card__price">79€</p>
          </div>
          <div class="consulta-card__examples">
            <p class="consulta-card__examples-label">Consultas frecuentes</p>
            <ul>
              <li>Llevamos meses durmiendo mal.</li>
              <li>Las comidas son una batalla constante.</li>
              <li>Hay dificultades con sueño, alimentación o conducta.</li>
              <li>Nos preocupa el uso de pantallas.</li>
              <li>Acabamos de recibir un diagnóstico y necesitamos orientación.</li>
              <li>Queremos un plan adaptado a nuestra situación.</li>
            </ul>
          </div>
          <ul class="consulta-card__checklist">
            <li class="checklist--yes">Videollamada 45-50 min</li>
            <li class="checklist--yes">Entender contexto completo</li>
            <li class="checklist--yes">Plan adaptado a la familia</li>
            <li class="checklist--yes">Recomendaciones prácticas</li>
            <li class="checklist--yes">Seguimiento durante 7 días (respuesta en 24h)</li>
            <li class="checklist--yes">Audios explicativos</li>
            <li class="checklist--yes">Ajustes durante la semana</li>
            <li class="checklist--yes">Nuevas dudas derivadas</li>
          </ul>
          <div class="consulta-card__footer">
            <button data-cal-link={`${CAL_USERNAME}/${CAL_PERSONALIZADA_SLUG}`} data-cal-config='{"layout":"month_view"}' class="btn btn--primary">Reservar consulta</button>
          </div>
        </div>

      </div>

      <!-- Tier 4: Acompañamiento — separado, ancho completo -->
      <div class="consultas__pack">
        <div class="consulta-card consulta-card--pack">
          <div class="consulta-card--pack__layout">
            <div class="consulta-card__header">
              <span class="consulta-card__badge">❤️ Pack</span>
              <h2>Acompañamiento</h2>
              <p class="consulta-card__tagline">3 sesiones en 1-2 meses</p>
              <p class="consulta-card__price">199€</p>
            </div>
            <div class="consulta-card__body">
              <p>Para procesos que necesitan seguimiento, ajustes y apoyo durante varias semanas. Incluye valoración inicial, plan personalizado y seguimiento por videollamada para adaptar las recomendaciones según evolucionéis.</p>
              <div class="consulta-card__examples">
                <p class="consulta-card__examples-label">Consultas frecuentes</p>
                <ul>
                  <li>Problemas de sueño de larga evolución.</li>
                  <li>Rechazo de alimentos o alimentación muy limitada.</li>
                  <li>Destete.</li>
                  <li>Inicio de alimentación complementaria con acompañamiento.</li>
                  <li>Adaptación a la guardería.</li>
                  <li>Llegada de un hermano.</li>
                  <li>Cambio de cuna a cama.</li>
                  <li>Prematuridad y adaptación en casa.</li>
                </ul>
              </div>
              <ul class="consulta-card__checklist">
                <li class="checklist--yes">3 sesiones</li>
                <li class="checklist--yes">Seguimiento entre sesiones</li>
                <li class="checklist--yes">Ajustes sobre la marcha</li>
                <li class="checklist--yes">Prioridad en mensajes</li>
                <li class="checklist--yes">Adaptación según evolucione el bebé</li>
              </ul>
              <p class="consulta-card__highlight consulta-card__highlight--pack">No tienes que resolverlo todo de golpe. Avanzamos paso a paso, adaptándonos a vuestra realidad.</p>
            </div>
            <div class="consulta-card__footer">
              <button class="btn btn--primary">Reservar acompañamiento</button>
            </div>
          </div>
        </div>
      </div>

      <div class="consultas__info">
        <p>Nos vemos por videollamada. Tú eliges el día y la hora, y yo me preparo para que aprovechemos el tiempo al máximo.</p>
        <p class="consultas__note">Al reservar te pediré que me cuentes cuál es tu preocupación principal y la edad de tu peque. Así llego preparada y vamos directos a lo importante.</p>
      </div>
    </div>
  </section>
</Layout>

<!-- Cal.com embed script -->
<script is:inline>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", {origin:"https://cal.com"});
  Cal("ui", {"styles":{"branding":{"brandColor":"#EE9496"}},"hideEventTypeDetails":false,"layout":"month_view","locale":"es"});
</script>

<!-- Consulta por mensaje: checkout flow -->
<script is:inline>
  document.getElementById('btn-consulta-mensaje')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-consulta-mensaje');
    if (btn) btn.textContent = 'Procesando...';
    try {
      const res = await fetch('/api/checkout-consulta', { method: 'POST' });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Error al crear el pago. Inténtalo de nuevo.');
        if (btn) btn.textContent = 'Consultar por mensaje';
      }
    } catch {
      alert('Error de conexión. Inténtalo de nuevo.');
      if (btn) btn.textContent = 'Consultar por mensaje';
    }
  });
</script>

<style>
  .consultas {
    padding: var(--spacing-xl) 0;
  }

  .consultas__intro {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .consultas__intro h1 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .consultas__subtitle {
    color: var(--color-coral);
    font-weight: 500;
    font-size: 1.1rem;
    margin-bottom: var(--spacing-xs);
  }

  .consultas__desc {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .consultas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(5, auto);
    gap: var(--spacing-lg);
    max-width: 1100px;
    margin: 0 auto;
  }

  .consulta-card {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: var(--spacing-sm);
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .consultas__pack {
    max-width: 1100px;
    margin: var(--spacing-lg) auto 0;
  }

  .consulta-card--pack {
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .consulta-card--pack__layout {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .consulta-card--pack .consulta-card__header {
    margin-bottom: 0;
  }

  .consulta-card--pack .consulta-card__body {
    flex: unset;
  }

  .consulta-card--pack .consulta-card__body > p {
    margin-bottom: var(--spacing-sm);
  }

  .consulta-card--pack .consulta-card__footer {
    margin-top: 0;
  }

  .consulta-card--featured {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 2px solid var(--color-coral);
  }

  .consulta-card__header {
    margin-bottom: var(--spacing-md);
  }

  .consulta-card__badge {
    display: inline-block;
    background-color: var(--color-cream);
    color: var(--color-coral);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: var(--spacing-sm);
  }

  .consulta-card__badge--featured {
    background-color: var(--color-coral);
    color: var(--color-white);
  }

  .consulta-card__header h2 {
    font-size: 1.3rem;
    margin-bottom: var(--spacing-xs);
  }

  .consulta-card__tagline {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--spacing-sm);
  }

  .consulta-card__price {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .consulta-card__savings {
    font-size: 0.8rem;
    color: var(--color-coral);
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .consulta-card__includes {
    margin-top: auto;
    padding-top: var(--spacing-lg);
  }

  .consulta-card__highlight {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-style: italic;
    margin-bottom: var(--spacing-md);
  }

  .consulta-card__examples {
    margin-bottom: var(--spacing-md);
  }

  .consulta-card__examples-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-coral);
    margin-bottom: 0.4rem;
  }

  .consulta-card__examples ul {
    list-style: none;
    padding: 0;
  }

  .consulta-card__examples li {
    position: relative;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    font-style: italic;
    padding-left: 1.5rem;
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }

  .consulta-card__examples li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-coral);
    font-style: normal;
    font-weight: 700;
  }

  .consulta-card__note {
    margin-top: var(--spacing-sm);
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  .consulta-card__highlight--pack {
    margin-top: var(--spacing-md);
    margin-bottom: 0;
  }

  .consulta-card__checklist {
    list-style: none;
    padding: 0;
    padding-top: var(--spacing-md);
  }

  .consulta-card__checklist li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .consulta-card__checklist li::before {
    position: absolute;
    left: 0;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .consulta-card__checklist li.checklist--yes::before {
    content: '✓';
    color: var(--color-coral);
  }

  .consulta-card__checklist li.checklist--no::before {
    content: '✗';
    color: var(--color-text-tertiary);
  }

  .consulta-card__checklist li.checklist--no {
    color: var(--color-text-tertiary);
  }

  .consulta-card__includes {
    margin-top: auto;
    padding-top: var(--spacing-lg);
  }

  .consulta-card__includes > p {
    margin-bottom: var(--spacing-sm);
    font-size: 0.9rem;
  }

  .consulta-card__includes ul {
    list-style: none;
    padding: 0;
  }

  .consulta-card__includes li::before {
    content: '✓';
    font-size: 0.85rem;
  }

  .consulta-card__footer {
    margin-top: var(--spacing-lg);
  }

  .consulta-card__footer .btn {
    display: block;
  }

  .consultas__info {
    text-align: center;
    max-width: 600px;
    margin: var(--spacing-xl) auto 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .consultas__note {
    margin-top: var(--spacing-md);
    padding: var(--spacing-md);
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    color: var(--color-text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 1024px) {
    .consultas__grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 750px;
    }

    .consulta-card--pack__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .consultas__intro h1 {
      font-size: 2rem;
    }

    .consultas__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      max-width: 500px;
    }

    .consulta-card {
      display: flex;
      flex-direction: column;
      grid-row: unset;
    }

    .consulta-card--pack__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
