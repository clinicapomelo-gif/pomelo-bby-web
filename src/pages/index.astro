---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio">
  <section class="hero">
    <div class="container">
      <h1>Cuidamos de tu bebé, juntas</h1>
      <p class="hero__subtitle">Enfermería pediátrica. Consejos, guías y acompañamiento profesional para el cuidado de tu hijo.</p>
      <div class="hero__ctas">
        <a href="/tienda" class="btn btn--primary">Ver guías</a>
        <a href="/consultas" class="btn btn--secondary">Reservar consulta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-cream);
    text-align: center;
  }

  .hero h1 {
    font-size: 2.8rem;
    margin-bottom: var(--spacing-md);
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--spacing-lg);
  }

  .hero__ctas {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-coral);
    color: var(--color-white);
  }

  .btn--primary:hover {
    background-color: var(--color-coral-hover);
    color: var(--color-white);
  }

  .btn--secondary {
    background-color: transparent;
    color: var(--color-coral);
    border: 2px solid var(--color-coral);
  }

  .btn--secondary:hover {
    background-color: var(--color-coral);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .hero__subtitle {
      font-size: 1rem;
    }
  }
</style>
