---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LeadMagnetForm from '../components/LeadMagnetForm.astro';
import { CONSULTATIONS_ENABLED } from '../data/consultas';
import { GUIDES_ENABLED, formatGuiaCategory, formatGuiaKind, guias, isGuiaVisible } from '../data/guias';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const featuredGuides = guias
  .filter((guia) => isGuiaVisible(guia, undefined))
  .slice(0, 3);

const categoryColors: Record<string, { accent: string }> = {
  alimentacion: { accent: 'var(--color-cat-alimentacion-accent)' },
  sueño: { accent: 'var(--color-cat-sueno-accent)' },
  salud: { accent: 'var(--color-cat-salud-accent)' },
  desarrollo: { accent: 'var(--color-cat-desarrollo-accent)' },
  crianza: { accent: 'var(--color-cat-crianza-accent)' },
};

const categoryLabels: Record<string, string> = {
  alimentacion: 'Alimentación',
  sueño: 'Sueño',
  salud: 'Salud',
  desarrollo: 'Desarrollo',
  crianza: 'Crianza',
};
---

<Layout
  title="Salud infantil y crianza, sin dramas"
  description="Pomelo Baby te ayuda a entender la salud infantil, separar lo importante del ruido y saber qué hacer después."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__text">
        <h1>
          <span class="hero__line">Salud infantil</span>
          <span class="hero__line">y crianza,</span>
          <span class="hero__line hero__line--accent">sin dramas.</span>
        </h1>
        <p class="hero__lead">Información fiable para entender a tu hijo/a, tomar decisiones con criterio y vivir la crianza con un poco menos de ruido.</p>
        <p class="hero__intro">Soy Mar, enfermera y divulgadora de salud infantil.</p>
        <p class="hero__proof">Baso mis recomendaciones en la evidencia científica actual, pero te las explico con sentido común y en palabras normales.</p>
        <p class="hero__aside">Sin culpa. Sin alarmismo. Sin consejos contradictorios.</p>
        <div class="hero__cta">
          <a href="/consultas" class="btn btn--primary">Quiero hablar con Mar</a>
          <a href="/guias" class="btn btn--secondary">Ver las guías</a>
        </div>
      </div>
      <div class="hero__portrait">
        <div class="hero__arch">
          <img
            src="/mar-inicio.webp"
            alt="Mar, enfermera infantil y creadora de Pomelo Baby"
            class="hero__photo"
            width="1200"
            height="1601"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Caminos -->
  <section class="paths" aria-labelledby="paths-title">
    <div class="container">
      <header class="section-heading">
        <p class="section-heading__eyebrow">Empieza por aquí</p>
        <h2 id="paths-title">¿Qué necesitas hoy?</h2>
      </header>
      <div class="paths__grid">
        <a href="/consultas" class="path-card">
          <span class="path-card__number" aria-hidden="true">01</span>
          <h3>Tengo una duda</h3>
          <p>Agendamos una cita online y hablamos de vuestro caso concreto.</p>
          <span class="path-card__link">Quiero consultar <span aria-hidden="true">→</span></span>
        </a>
        <a href="/guias" class="path-card">
          <span class="path-card__number" aria-hidden="true">02</span>
          <h3>Quiero aprender y estar preparada/o</h3>
          <p>Guías que recogen la evidencia actual sobre salud infantil y crianza, explicadas de manera sencilla.</p>
          <span class="path-card__link">Ver las guías <span aria-hidden="true">→</span></span>
        </a>
        <a href="/blog" class="path-card">
          <span class="path-card__number" aria-hidden="true">03</span>
          <h3>Quiero entender mejor la crianza</h3>
          <p>Aquí escribo. Es un cajón de sastre de ideas que te pueden interesar cuando eres papá/mamá.</p>
          <span class="path-card__link">Leer el blog <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Manifiesto -->
  <section class="manifesto" aria-labelledby="manifesto-title">
    <div class="container manifesto__inner">
      <p class="manifesto__line">No necesitas saberlo todo.</p>
      <h2 id="manifesto-title">Necesitas saber qué importa.</h2>
      <div class="manifesto__copy">
        <p>En Pomelo&nbsp;Baby encontrarás información sobre salud infantil, explicada de forma clara por una enfermera. Aprenderás cuándo debes consultar, sin convertir cada cuestión de salud en una emergencia.</p>
        <p>Porque criar ya es suficientemente difícil como para además, hacerlo con miedo.</p>
      </div>
    </div>
  </section>

  <!-- Por qué Pomelo -->
  <section class="why-pomelo" aria-labelledby="why-pomelo-title">
    <div class="container why-pomelo__inner">
      <h2 id="why-pomelo-title">¿Por qué Pomelo&nbsp;Baby?</h2>
      <div class="why-pomelo__content">
        <p>Porque información hay de sobra. Lo difícil es saber qué hacer con ella.</p>
        <p>Yo te ayudo a separar lo importante del ruido, entender los tecnicismos y tomar decisiones con más criterio y menos miedo.</p>
        <a href="/sobre-mi">Conoce a Mar <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Consultas -->
  <section id="consultas" class="home-consultations" aria-labelledby="home-consultations-title">
    <div class="container">
      <header class="home-consultations__header">
        <h2 id="home-consultations-title">Consultas online con Mar</h2>
        <p class="home-consultations__subtitle">Porque a veces necesitas una respuesta rápida. Y otras, poder hablarlo con tranquilidad.</p>
        <p class="home-consultations__intro">Otras situaciones necesitan algo más: ordenar varias piezas y hacer seguimiento.</p>
        <p class="home-consultations__choice">Por eso puedes elegir el formato que mejor encaje con vuestra situación.</p>
      </header>

      <ul class="home-consultations__options" aria-label="Modalidades de consulta">
        <li>
          <article class="home-consultations__card">
            <p class="home-consultations__need">Tengo una duda concreta</p>
            <h3>Respuesta por escrito</h3>
            <p class="home-consultations__description">Para cuando tienes una duda puntual y quieres saber qué puede estar pasando, qué puedes hacer y cuándo deberías consultar.</p>
            <p class="home-consultations__ideal"><strong>Ideal si:</strong> quieres una respuesta clara sin necesidad de una videollamada.</p>
            <div class="home-consultations__card-footer">
              <a href="/consultas#consulta-correo">Quiero mi respuesta <span aria-hidden="true">→</span></a>
              {!CONSULTATIONS_ENABLED && <span>Próximamente</span>}
            </div>
          </article>
        </li>
        <li>
          <article class="home-consultations__card">
            <p class="home-consultations__need">Quiero hablarlo contigo</p>
            <h3>Consulta por videollamada</h3>
            <p class="home-consultations__description">Para cuando necesitas contarme el contexto, resolver varias dudas o simplemente prefieres hablarlo cara a cara.</p>
            <p class="home-consultations__ideal"><strong>Ideal si:</strong> necesitas poder explicar la situación y conversar sobre ella.</p>
            <div class="home-consultations__card-footer">
              <a href="/consultas#duda-concreta">Quiero hablar con Mar <span aria-hidden="true">→</span></a>
              {!CONSULTATIONS_ENABLED && <span>Próximamente</span>}
            </div>
          </article>
        </li>
        <li>
          <article class="home-consultations__card">
            <p class="home-consultations__need">Necesito un poco más de acompañamiento</p>
            <h3>Videollamada + seguimiento</h3>
            <p class="home-consultations__description">Para situaciones en las que una sola conversación se queda corta y necesitas ordenar varias piezas y hacer seguimiento.</p>
            <p class="home-consultations__ideal"><strong>Ideal si:</strong> quieres que podamos revisar cómo evoluciona la situación.</p>
            <div class="home-consultations__card-footer">
              <a href="/consultas#hablemos-tranquilamente">Quiero seguimiento <span aria-hidden="true">→</span></a>
              {!CONSULTATIONS_ENABLED && <span>Próximamente</span>}
            </div>
          </article>
        </li>
      </ul>

      <p class="home-consultations__notice">Las consultas online no sustituyen una valoración médica presencial cuando esta sea necesaria. Si existe una situación urgente, debes acudir a los servicios de emergencia correspondientes.</p>
    </div>
  </section>

  <!-- Guías -->
  <section class="guides" aria-labelledby="guides-title">
    <div class="container">
      <div class="guides__header">
        <div>
          <p class="section-heading__eyebrow">Herramientas para familias</p>
          <h2 id="guides-title">Guías Pomelo&nbsp;Baby</h2>
        </div>
        <p>Información basada en evidencia, explicada en palabras normales. Para que tomes decisiones con criterio y te sientas más seguro/a en el día a día.</p>
      </div>
      <div class="guides__grid">
        {featuredGuides.map((guide) => (
          <a href={`/guias/${guide.id}`} class="guide-card">
            <div class="guide-card__top">
              <span>{formatGuiaKind(guide.kind)}</span>
              <span>{formatGuiaCategory(guide.category)}</span>
            </div>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <div class="guide-card__footer">
              <strong>{GUIDES_ENABLED ? 'Ver guía' : 'Próximamente'}</strong>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <div class="section-link">
        <a href="/guias">Ver todas las guías <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="blog" aria-labelledby="blog-title">
    <div class="container">
      <header class="section-heading section-heading--center">
        <h2 id="blog-title">El blog de Pomelo</h2>
        <p class="blog__subtitle">Escribo sobre dudas habituales.</p>
        <p class="blog__intro">Intento resolverlas de forma sencilla y con información fiable. Para que termines la lectura con menos ruido mental y las ideas un poco más claras.</p>
      </header>
      <div class="blog__grid">
        {latestPosts.map((post) => {
          const colors = categoryColors[post.data.category] || categoryColors.crianza;
          return (
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-card__image">
                {post.data.image ? (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                ) : (
                  <div class={`post-card__placeholder post-card__placeholder--${post.data.category}`}>
                    <svg class="post-card__icon" viewBox="0 0 24 24" fill="none" stroke={colors.accent} stroke-width="1.5" aria-hidden="true">
                      <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </div>
                )}
              </div>
              <div class="post-card__content">
                <span class="post-card__category">{categoryLabels[post.data.category]}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
      <div class="section-link">
        <a href="/blog">Ver todos los artículos <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- El Chisme -->
  <LeadMagnetForm eyebrow="El Chisme de Mar" />

  <!-- Cierre -->
  <section class="closing" aria-labelledby="closing-title">
    <div class="container closing__inner">
      <h2 id="closing-title">
        <span class="closing__line">¿Hay algo que te preocupa?</span>
        <span class="closing__line closing__line--accent">Cuéntamelo.</span>
      </h2>
      <p>No hace falta que sepas exactamente qué necesitas. Cuéntame qué está pasando y vemos juntas/os por dónde empezar.</p>
      <div class="closing__cta">
        <a href="/consultas" class="btn btn--primary">Quiero hablar con Mar <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(3.5rem, 8vw, 7rem) var(--spacing-lg);
    background-color: var(--color-cream);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 360px);
    align-items: center;
    gap: clamp(var(--spacing-xl), 8vw, 7rem);
    max-width: 1120px;
    margin: 0 auto;
  }

  .hero__text {
    max-width: 680px;
  }

  .section-heading__eyebrow {
    margin-bottom: var(--spacing-sm);
    color: var(--color-coral-hover);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 720px;
    margin-bottom: var(--spacing-lg);
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .hero__line {
    display: block;
    text-wrap: balance;
  }

  .hero__line--accent {
    color: var(--color-coral);
    white-space: nowrap;
  }

  .hero__lead {
    max-width: 630px;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    line-height: 1.5;
  }

  .hero__intro {
    margin-bottom: var(--spacing-xs);
    color: var(--color-text);
    font-weight: 700;
  }

  .hero__proof {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-secondary);
  }

  .hero__aside {
    margin-bottom: var(--spacing-lg);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .hero__cta,
  .closing__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .hero__portrait {
    position: relative;
  }

  .hero__portrait::before {
    position: absolute;
    inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    border: 1px solid var(--color-peach);
    border-radius: 50% 50% var(--radius-md) var(--radius-md) / 30% 30% var(--radius-md) var(--radius-md);
    background-color: var(--color-nude);
    content: '';
  }

  .hero__arch {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 50% 50% var(--radius-md) var(--radius-md) / 30% 30% var(--radius-md) var(--radius-md);
    box-shadow: 0 12px 32px rgba(45, 45, 45, 0.1);
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .paths,
  .why-pomelo,
  .guides,
  .blog,
  .closing {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
  }

  .paths {
    background-color: var(--color-white);
  }

  .section-heading {
    max-width: 680px;
    margin-bottom: clamp(var(--spacing-lg), 5vw, var(--spacing-xl));
  }

  .section-heading h2,
  .guides h2,
  .home-consultations h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.025em;
  }

  .section-heading--center {
    margin-right: auto;
    margin-left: auto;
    text-align: center;
  }

  .section-heading--center {
    text-wrap: balance;
  }

  .blog__subtitle {
    margin: var(--spacing-sm) 0 var(--spacing-md);
    color: var(--color-coral-hover);
    font-weight: 600;
    line-height: 1.6;
  }

  .blog__intro {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .paths__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  .path-card {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-cream);
    color: var(--color-text);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .path-card:hover {
    border-color: var(--color-coral);
    color: var(--color-text);
    transform: translateY(-3px);
  }

  .path-card__number {
    margin-bottom: 0;
    color: var(--color-peach);
    font-size: 2rem;
    font-weight: 700;
  }

  .path-card h3 {
    min-height: 2lh;
    margin: var(--spacing-xl) 0 var(--spacing-sm);
    font-size: 1.25rem;
  }

  .path-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .path-card__link {
    margin-top: auto;
    padding-top: var(--spacing-md);
  }

  .path-card__link,
  .section-link a {
    color: var(--color-coral-hover);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .manifesto {
    padding: clamp(3.5rem, 7vw, 4rem) 0;
    background-color: var(--color-nude);
  }

  .manifesto__inner {
    max-width: 900px;
  }

  .manifesto__line {
    margin: 0 0 var(--spacing-md);
    color: var(--color-coral-hover);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }

  .manifesto__line::after {
    display: block;
    width: 3rem;
    height: 3px;
    margin: var(--spacing-md) auto 0;
    border-radius: 2px;
    background-color: var(--color-coral);
    content: '';
  }

  .manifesto h2 {
    max-width: 760px;
    margin: 0 auto;
    color: var(--color-text);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-align: center;
    text-wrap: balance;
  }

  .manifesto__copy {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(var(--spacing-lg), 5vw, 3rem);
    max-width: 820px;
    margin: var(--spacing-xl) auto 0;
  }

  .manifesto__copy p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .manifesto__copy p:last-child {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius-md);
    background-color: var(--color-coral);
    color: var(--color-white);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .why-pomelo {
    background-color: var(--color-white);
  }

  .why-pomelo__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(300px, 0.8fr);
    align-items: start;
    gap: clamp(var(--spacing-lg), 10vw, 8rem);
    max-width: 1040px;
  }

  .why-pomelo h2 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.8rem);
    letter-spacing: -0.04em;
  }

  .why-pomelo__content p {
    margin: 0 0 var(--spacing-md);
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .why-pomelo__content p:last-of-type {
    color: var(--color-text);
    font-weight: 600;
  }

  .why-pomelo__content a {
    display: inline-block;
    margin-top: var(--spacing-sm);
    color: var(--color-coral-hover);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .guides__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.8fr);
    align-items: start;
    gap: clamp(var(--spacing-lg), 8vw, 6rem);
    max-width: 1040px;
    margin: 0 auto;
  }

  .home-consultations {
    scroll-margin-top: 5rem;
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background-color: var(--color-cream);
  }

  .home-consultations__header {
    max-width: 720px;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
    text-wrap: balance;
  }

  .guides__header > p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .home-consultations__subtitle {
    margin: var(--spacing-sm) 0 var(--spacing-md);
    color: var(--color-coral-hover);
    font-weight: 600;
    line-height: 1.6;
  }

  .home-consultations__intro {
    margin: 0 0 var(--spacing-sm);
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .home-consultations__choice {
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.75;
  }

  .home-consultations__options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 1040px;
    margin: 0 auto;
  }

  .home-consultations__card {
    display: flex;
    height: 100%;
    min-height: 390px;
    flex-direction: column;
    padding: clamp(1.35rem, 2.5vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    color: var(--color-text);
  }

  .home-consultations__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .home-consultations__need {
    min-height: 3.2em;
    margin-bottom: var(--spacing-md);
    color: var(--color-coral-hover);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .home-consultations__card h3 {
    margin-bottom: var(--spacing-md);
    font-size: 1.25rem;
