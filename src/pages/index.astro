---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatGuiaPrice, guias } from '../data/guias';
import NewsletterForm from '../components/NewsletterForm.astro';

// Get published blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

// Get latest guides (max 2 for balanced grid)
const latestGuias = guias.slice(0, 2);

// Category colors for placeholders (using CSS variable values)
const categoryColors: Record<string, { bg: string; accent: string }> = {
  alimentacion: { bg: 'var(--color-cat-alimentacion-bg)', accent: 'var(--color-cat-alimentacion-accent)' },
  sueño: { bg: 'var(--color-cat-sueno-bg)', accent: 'var(--color-cat-sueno-accent)' },
  salud: { bg: 'var(--color-cat-salud-bg)', accent: 'var(--color-cat-salud-accent)' },
  desarrollo: { bg: 'var(--color-cat-desarrollo-bg)', accent: 'var(--color-cat-desarrollo-accent)' },
  crianza: { bg: 'var(--color-cat-crianza-bg)', accent: 'var(--color-cat-crianza-accent)' },
};
---

<Layout title="Inicio">
  <!-- Hero -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__portrait">
        <img
          src="/mar-inicio.webp"
          alt="Mar, enfermera infantil"
          class="hero__photo"
          width="1200"
          height="1601"
          fetchpriority="high"
        />
      </div>
      <div class="hero__text">
        <h1>Hola, soy Mar</h1>
        <p class="hero__credentials">La amiga enfermera a la que le mandarías un WhatsApp de: «Mar, igual estoy exagerando, pero ¿esto es normal?»</p>
        <p class="hero__tagline">Apasionada de la pediatría y con formación especializada en urgencias e intensivos pediátricos. La que te habla en palabras normales, te ayuda a entender qué está pasando y te devuelve la calma sin hacerte sentir culpable.</p>
        <p class="hero__tagline">Te acompaño en la salud y la crianza de tu peque con información actualizada y basada en evidencia, explicada de forma sencilla, sin juicios y sin necesidad de hacerlo perfecto.</p>
        <div class="hero__cta">
          <a href="/consultas" class="btn btn--primary">Reservar consulta</a>
          <a href="/tienda" class="btn btn--secondary">Ver guías</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Guías -->
  <section class="guides">
    <div class="container">
      <h2>Guías prácticas</h2>
      <p class="section-subtitle">Información clara y visual para consultar cuando la necesites</p>
      <div class="guides__grid">
        {latestGuias.map((guia) => {
          const colors = categoryColors[guia.category] || categoryColors.crianza;
          return (
            <a href={`/tienda/${guia.id}`} class="guide-card">
              <div class="guide-card__image">
                {guia.image ? (
                  <img src={guia.image} alt={guia.title} />
                ) : (
                  <div class="guide-card__placeholder" style={`background-color: ${colors.bg};`}>
                    <svg class="guide-card__icon" viewBox="0 0 24 24" fill="none" stroke={colors.accent} stroke-width="1.5">
                      <path d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="guide-card__content">
                <h3 class="guide-card__title">{guia.title}</h3>
                <p class="guide-card__desc">{guia.description}</p>
                <p class="guide-card__price">
                  {formatGuiaPrice(guia.price)}
                  {guia.status === 'coming-soon' && <span> · Próximamente</span>}
                </p>
              </div>
            </a>
          );
        })}
      </div>
      <div class="section-link">
        <a href="/tienda">Ver todas las guías →</a>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="blog">
    <div class="container">
      <h2>Lo último en el blog</h2>
      <p class="section-subtitle">Respuestas tranquilas a las dudas que te quitan el sueño</p>
      <div class="blog__grid">
        {latestPosts.map((post) => {
          const colors = categoryColors[post.data.category] || categoryColors.crianza;
          return (
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-card__image">
                {post.data.image ? (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} />
                ) : (
                  <div class="post-card__placeholder" style={`background-color: ${colors.bg};`}>
                    <svg class="post-card__icon" viewBox="0 0 24 24" fill="none" stroke={colors.accent} stroke-width="1.5">
                      <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="post-card__content">
                <span class="post-card__category">{post.data.category}</span>
                <h3 class="post-card__title">{post.data.title}</h3>
                <p class="post-card__desc">{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
      <div class="section-link">
        <a href="/blog">Ver todos los artículos →</a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <NewsletterForm />

  <!-- CTA Consultas -->
  <section class="cta-consultas">
    <div class="container">
      <div class="cta-consultas__card">
        <h2>¿Tienes dudas que no encuentras en ningún sitio?</h2>
        <p>Entre tanta sobreinformación de redes y tanta IA, a veces solo necesitas que un ser humano escuche tus preocupaciones y te explique las cosas con calma.</p>
        <a href="/consultas" class="btn btn--primary">Reservar consulta</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-cream);
    padding: clamp(3rem, 7vw, 6rem) var(--spacing-lg);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(260px, 350px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(var(--spacing-xl), 7vw, 5rem);
    max-width: 1080px;
    margin: 0 auto;
  }

  .hero__portrait {
    position: relative;
    aspect-ratio: 3 / 4;
  }

  .hero__portrait::before {
    content: '';
    position: absolute;
    inset: var(--spacing-md) -1rem -1rem var(--spacing-md);
    border: 1px solid var(--color-peach);
    border-radius: 11rem 11rem var(--radius-md) var(--radius-md);
    background-color: var(--color-nude);
  }

  .hero__photo {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 11rem 11rem var(--radius-md) var(--radius-md);
    object-fit: cover;
    box-shadow: 0 12px 32px rgba(45, 45, 45, 0.1);
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: var(--spacing-xs);
  }

  .hero__credentials {
    font-size: 0.9rem;
    color: var(--color-coral);
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }

  .hero__tagline {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  .hero__cta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  /* Section common styles */
  .guides {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }

  .blog {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-cream);
  }

  .guides h2,
  .blog h2 {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: var(--spacing-xs);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--spacing-lg);
  }

  .section-link {
    text-align: center;
    margin-top: var(--spacing-lg);
  }

  .section-link a {
    color: var(--color-coral);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .section-link a:hover {
    text-decoration: underline;
  }

  /* Guide cards */
  .guides__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    max-width: 700px;
    margin: 0 auto;
  }

  .guide-card {
    display: block;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .guide-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .guide-card__image {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .guide-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .guide-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .guide-card__icon {
    width: 64px;
    height: 64px;
    opacity: 0.7;
  }

  .guide-card__content {
    padding: var(--spacing-md) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    min-height: 160px;
  }

  .guide-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    line-height: 1.3;
    color: var(--color-text);
  }

  .guide-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
    flex-grow: 1;
  }

  .guide-card__price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-coral);
    margin-bottom: 0;
    margin-top: auto;
    text-align: right;
  }

  /* Blog cards */
  .blog__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    max-width: 700px;
    margin: 0 auto;
  }

  .post-card {
    display: block;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .post-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .post-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-card__icon {
    width: 48px;
    height: 48px;
    opacity: 0.6;
  }

  .post-card__content {
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .post-card__category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-coral);
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    display: block;
  }

  .post-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    line-height: 1.3;
    color: var(--color-text);
  }

  .post-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
  }

  /* CTA Consultas */
  .cta-consultas {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }

  .cta-consultas__card {
    padding: var(--spacing-lg);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-consultas h2 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .cta-consultas p {
    color: var(--color-text-secondary);
    margin: 0 auto var(--spacing-md);
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .guides__grid,
    .blog__grid {
      max-width: 500px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-lg) var(--spacing-lg);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--spacing-xl);
      text-align: center;
    }

    .hero__portrait {
      width: min(78vw, 300px);
    }

    .hero__portrait::before {
      inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    }

    .hero__text {
      max-width: 600px;
    }

    .hero h1 {
      font-size: 1.75rem;
    }

    .hero__cta {
      justify-content: center;
    }

    .guides__grid,
    .blog__grid {
      grid-template-columns: 1fr;
      max-width: 340px;
    }

    .guides h2,
    .blog h2,
    .cta-consultas h2 {
      font-size: 1.3rem;
    }
  }
</style>
