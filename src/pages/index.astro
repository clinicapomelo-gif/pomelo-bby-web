---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import LeadMagnetForm from '../components/LeadMagnetForm.astro';

// Get published blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

// Category colors for placeholders (using CSS variable values)
const categoryColors: Record<string, { bg: string; accent: string }> = {
  alimentacion: { bg: 'var(--color-cat-alimentacion-bg)', accent: 'var(--color-cat-alimentacion-accent)' },
  sueño: { bg: 'var(--color-cat-sueno-bg)', accent: 'var(--color-cat-sueno-accent)' },
  salud: { bg: 'var(--color-cat-salud-bg)', accent: 'var(--color-cat-salud-accent)' },
  desarrollo: { bg: 'var(--color-cat-desarrollo-bg)', accent: 'var(--color-cat-desarrollo-accent)' },
  crianza: { bg: 'var(--color-cat-crianza-bg)', accent: 'var(--color-cat-crianza-accent)' },
};
---

<Layout title="Inicio">
  <!-- Hero -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__portrait">
        <div class="hero__arch">
          <img
            src="/mar-inicio.webp"
            alt="Mar, enfermera infantil"
            class="hero__photo"
            width="1200"
            height="1601"
            fetchpriority="high"
          />
        </div>
      </div>
      <div class="hero__text">
        <h1>Hola, soy Mar</h1>
        <p class="hero__promise">Salud infantil y crianza, sin dramas, sin culpa y sin perderte entre 200 consejos de Instagram.</p>
        <p class="hero__tagline">Soy enfermera. Te ayudo a separar el ruido de lo importante, entender qué está pasando y saber cuál puede ser el siguiente paso, con calma y en palabras normales.</p>
        <div class="hero__cta">
          <a href="/consultas" class="btn btn--primary">Quiero hablar con Mar</a>
          <a href="#guia-gratuita" class="btn btn--secondary">Quiero la guía gratuita</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Consultas -->
  <section class="home-consultations" aria-labelledby="home-consultations-title">
    <div class="container">
      <div class="home-consultations__intro">
        <p class="home-consultations__eyebrow">Orientación para vuestra familia</p>
        <h2 id="home-consultations-title">¿Necesitas ayuda con una situación concreta?</h2>
        <p>No siempre necesitas leer otro artículo. A veces necesitas contarme qué está pasando, ordenar toda la información y saber qué observar y cuál puede ser el siguiente paso.</p>
        <p>Puedes consultarme dudas sobre cuidados, alimentación, sueño, desarrollo y crianza. Recibirás una orientación de enfermería clara, práctica y adaptada a vuestra familia.</p>
      </div>
      <ul class="home-consultations__options" aria-label="Modalidades de consulta">
        <li>
          <h3>Cuéntame por correo</h3>
          <p>Una duda por escrito</p>
          <strong>19 €</strong>
        </li>
        <li>
          <h3>Duda concreta</h3>
          <p>Videollamada de unos 20 minutos</p>
          <strong>49 €</strong>
        </li>
        <li>
          <h3>Hablemos tranquilamente</h3>
          <p>Plan personalizado y seguimiento</p>
          <strong>89 €</strong>
        </li>
      </ul>
      <div class="home-consultations__action">
        <a href="/consultas" class="btn btn--primary">Quiero hablar con Mar</a>
        <p>Consultas de enfermería. No incluyen diagnóstico médico, prescripción ni atención de urgencias. <a href="/aviso-legal">Consulta el alcance profesional</a>.</p>
      </div>
    </div>
  </section>

  <!-- Guía gratuita y El Chisme -->
  <LeadMagnetForm />

  <!-- Blog -->
  <section class="blog">
    <div class="container">
      <h2>Lo último en el blog</h2>
      <p class="section-subtitle">Respuestas tranquilas a las dudas que te quitan el sueño</p>
      <div class="blog__grid">
        {latestPosts.map((post) => {
          const colors = categoryColors[post.data.category] || categoryColors.crianza;
          return (
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-card__image">
                {post.data.image ? (
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} />
                ) : (
                  <div class="post-card__placeholder" style={`background-color: ${colors.bg};`}>
                    <svg class="post-card__icon" viewBox="0 0 24 24" fill="none" stroke={colors.accent} stroke-width="1.5">
                      <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                )}
              </div>
              <div class="post-card__content">
                <span class="post-card__category">{post.data.category}</span>
                <h3 class="post-card__title">{post.data.title}</h3>
                <p class="post-card__desc">{post.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
      <div class="section-link">
        <a href="/blog">Ver todos los artículos →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-cream);
    padding: clamp(3rem, 7vw, 6rem) var(--spacing-lg);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(260px, 350px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(var(--spacing-xl), 7vw, 5rem);
    max-width: 1080px;
    margin: 0 auto;
  }

  .hero__portrait {
    position: relative;
  }

  .hero__portrait::before {
    content: '';
    position: absolute;
    inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    border: 1px solid var(--color-peach);
    border-radius: 50% 50% var(--radius-md) var(--radius-md) / 30% 30% var(--radius-md) var(--radius-md);
    background-color: var(--color-nude);
  }

  .hero__arch {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 50% 50% var(--radius-md) var(--radius-md) / 30% 30% var(--radius-md) var(--radius-md);
    box-shadow: 0 12px 32px rgba(45, 45, 45, 0.1);
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: var(--spacing-xs);
  }

  .hero__promise {
    color: var(--color-coral-text);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: var(--spacing-md);
  }

  .hero__tagline {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  .hero__cta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  /* Consultas */
  .home-consultations {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }

  .home-consultations__intro {
    max-width: 720px;
    margin: 0 auto var(--spacing-lg);
    text-align: center;
  }

  .home-consultations__eyebrow {
    color: var(--color-coral-text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-consultations h2 {
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .home-consultations__intro > p:not(.home-consultations__eyebrow) {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .home-consultations__options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    max-width: 900px;
    margin: 0 auto var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .home-consultations__options li {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-cream);
  }

  .home-consultations__options h3 {
    margin-bottom: var(--spacing-xs);
    font-size: 1.05rem;
  }

  .home-consultations__options p {
    flex-grow: 1;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .home-consultations__options strong {
    color: var(--color-coral-text);
    font-size: 1.2rem;
  }

  .home-consultations__action {
    text-align: center;
  }

  .home-consultations__action p {
    max-width: 680px;
    margin: var(--spacing-md) auto 0;
    color: var(--color-text-tertiary);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .home-consultations__action p a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* Blog */
  .blog {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-cream);
  }

  .blog h2 {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: var(--spacing-xs);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: var(--spacing-lg);
  }

  .section-link {
    text-align: center;
    margin-top: var(--spacing-lg);
  }

  .section-link a {
    color: var(--color-coral);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .section-link a:hover {
    text-decoration: underline;
  }

  /* Blog cards */
  .blog__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    max-width: 700px;
    margin: 0 auto;
  }

  .post-card {
    display: block;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .post-card__image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .post-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .post-card__icon {
    width: 48px;
    height: 48px;
    opacity: 0.6;
  }

  .post-card__content {
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .post-card__category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-coral);
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    display: block;
  }

  .post-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    line-height: 1.3;
    color: var(--color-text);
  }

  .post-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .blog__grid {
      max-width: 500px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--spacing-lg) var(--spacing-lg);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--spacing-xl);
      text-align: center;
    }

    .hero__portrait {
      width: min(78vw, 300px);
    }

    .hero__portrait::before {
      inset: 0.75rem -0.75rem -0.75rem 0.75rem;
    }

    .hero__text {
      max-width: 600px;
    }

    .hero h1 {
      font-size: 1.75rem;
    }

    .hero__cta {
      justify-content: center;
    }

    .home-consultations__options {
      grid-template-columns: 1fr;
      max-width: 420px;
    }

    .home-consultations__options li {
      padding: var(--spacing-md);
    }

    .blog__grid {
      grid-template-columns: 1fr;
      max-width: 340px;
    }

    .blog h2 {
      font-size: 1.3rem;
    }
  }
</style>
