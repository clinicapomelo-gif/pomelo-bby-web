---
import Layout from '../../layouts/Layout.astro';
import Stripe from 'stripe';
import {
  getConsultationReference,
  getConsultationStripeMode,
  isPaidConsultationSession,
} from '../../lib/consulta-payment.mjs';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

// Verificar que el session_id es válido y está pagado
const url = new URL(Astro.request.url);
const sessionId = url.searchParams.get('session_id');
const hasSubmitError = url.searchParams.has('error');

// «unchecked»: Stripe no respondió. No se manda a /consultas: el pago puede ser bueno
// y la familia ya tiene el enlace en su correo.
let status: 'invalid' | 'unchecked' | 'sent' | 'ready' = 'invalid';

if (sessionId?.startsWith('cs_') && sessionId.length <= 255) {
  const stripeKey = import.meta.env.STRIPE_SECRET_KEY;
  const stripeMode = getConsultationStripeMode(stripeKey, process.env.VERCEL_ENV);
  if (stripeKey && stripeMode) {
    try {
      const stripe = new Stripe(stripeKey);
      const session = await stripe.checkout.sessions.retrieve(sessionId);
      if (isPaidConsultationSession(session, stripeMode)) {
        status = session.metadata?.consultaEnviada === 'true' ? 'sent' : 'ready';
      }
    } catch {
      status = 'unchecked';
    }
  }
}

if (status === 'invalid') {
  return Astro.redirect('/consultas');
}

if (status === 'sent') {
  return Astro.redirect('/consulta-mensaje/enviado');
}

const reference = getConsultationReference(sessionId);
const consultaEmail = import.meta.env.RESEND_CONSULTA_TO_EMAIL ?? '';
---

<Layout title="Cuéntame tu caso" description="Has reservado tu consulta por correo. Cuéntame qué te preocupa y te respondo en 24-48 horas laborables." noindex={true}>
  <section class="consulta-form">
    <div class="container">
      <div class="consulta-form__header">
        <h1>Cuéntame tu caso</h1>
        <p class="consulta-form__subtitle">Gracias por confiar en mí. Ahora cuéntame qué te preocupa con calma. Te respondo en 24-48 horas laborables.</p>
        <p class="consulta-form__ref">Referencia: <strong>{reference}</strong></p>
      </div>

      {status === 'unchecked' ? (
      <div class="consulta-form__wrapper consulta-form__unchecked" role="alert">
        {/* TODO(Mar): texto provisional. */}
        <p>No he podido comprobar tu pago ahora mismo. No te preocupes: si has pagado, ya tienes en tu correo un enlace para volver aquí.</p>
        <a href={url.pathname + url.search} class="btn btn--primary">Volver a intentarlo</a>
      </div>
      ) : (
      <div class="consulta-form__wrapper">
        <form
          name="consulta-mensaje"
          method="POST"
          action="/api/consulta-mensaje"
          class="form"
          data-consulta-form
          data-friendly-validation
          novalidate
        >
          <input type="hidden" name="session_id" value={sessionId} />
          <div class="form__group" data-validation-field>
            <label for="nombre">Tu nombre</label>
            <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required data-error-required="Cuéntame cómo te llamas." />
          </div>

          <div class="form__group">
            <label for="telefono">Teléfono de contacto <span>(opcional)</span></label>
            <input type="tel" id="telefono" name="telefono" autocomplete="tel" maxlength="30" placeholder="Tu teléfono" aria-describedby="telefono-ayuda" />
            <small id="telefono-ayuda">Si lo dejas, puedo escribirte por WhatsApp cuando sea más fácil aclarar algo. Si no, te respondo por email.</small>
          </div>

          <div class="form__group" data-validation-field>
            <label for="edad">Edad del bebé</label>
            <input type="text" id="edad" name="edad" placeholder="Ej: 4 meses, 14 meses..." required data-error-required="Cuéntame qué edad tiene tu bebé." />
          </div>

          <div class="form__group" data-validation-field>
            <label for="motivo">¿Qué te preocupa?</label>
            <textarea id="motivo" name="motivo" rows="6" placeholder="Cuéntame con calma qué está pasando, desde cuándo, qué habéis probado... Todo lo que creas que me puede ayudar a entender vuestro caso." required data-error-required="Cuéntame qué te preocupa para que pueda ayudarte."></textarea>
          </div>

          <div class="form__group">
            <label for="contexto">Contexto adicional (opcional)</label>
            <textarea id="contexto" name="contexto" rows="3" placeholder="Antecedentes, medicación, si ha pasado algo reciente..."></textarea>
          </div>

          <div class="form__group">
            <p class="form__help">Si para valorar tu caso hacen falta fotos o vídeos, te explicaré el siguiente paso cuando te responda. No los envíes todavía ni por Instagram.</p>
          </div>

          <p class="form__privacy"><strong>Privacidad:</strong> Piel de Pomelo S.L.P tratará tus datos y los del niño o niña para prestar la consulta de enfermería. Al enviarlos confirmas que eres su representante legal o que tienes autorización. Puedes consultar destinatarios, conservación y derechos en la <a href="/proteccion-datos" target="_blank" rel="noopener">política de privacidad</a>.</p>

          {/* TODO(Mar): texto provisional. */}
          <p class="form__help">Te responderé al email con el que has pagado.</p>

          <p class="form__message" data-consulta-message aria-live="polite" tabindex="-1" hidden={!hasSubmitError}>{hasSubmitError && 'No se pudo enviar tu caso. Revisa los campos e inténtalo de nuevo.'}</p>

          <button type="submit" class="btn btn--primary btn--full">
            Enviar mi caso
          </button>
        </form>

        <div class="consulta-fallback" data-consulta-fallback data-reference={reference} hidden>
          {/* TODO(Mar): texto provisional. */}
          <p>No he podido recibir tu caso desde la web. Para que no se pierda, cópialo y envíamelo por correo{consultaEmail && <> a <strong>{consultaEmail}</strong></>}.</p>
          <label for="consulta-copia">Tu caso</label>
          <textarea id="consulta-copia" rows="10" readonly data-consulta-copy></textarea>
          <div class="consulta-fallback__actions">
            <button type="button" class="btn btn--primary" data-consulta-copy-button>Copiar mi caso</button>
            {consultaEmail && <a class="btn btn--secondary" data-consulta-mailto data-email={consultaEmail} href={`mailto:${consultaEmail}`}>Abrir mi correo</a>}
          </div>
        </div>
      </div>
      )}
    </div>
  </section>
</Layout>

<script>
  const consultaForm = document.querySelector<HTMLFormElement>('[data-consulta-form]');
  const consultaMessage = document.querySelector<HTMLParagraphElement>('[data-consulta-message]');
  const consultaButton = consultaForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const fallback = document.querySelector<HTMLElement>('[data-consulta-fallback]');
  const fallbackCopy = document.querySelector<HTMLTextAreaElement>('[data-consulta-copy]');
  const fallbackCopyButton = document.querySelector<HTMLButtonElement>('[data-consulta-copy-button]');
  const fallbackMailto = document.querySelector<HTMLAnchorElement>('[data-consulta-mailto]');

  // El servidor ya ha reintentado. Si aun así no llega, el caso se ofrece para enviarlo
  // por correo, para que no se pierda lo escrito.
  const showFallback = (form: HTMLFormElement) => {
    if (!fallback || !fallbackCopy) return false;
    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) ?? '').trim();
    const reference = fallback.dataset.reference ?? '';
    const lines: string[] = [];
    if (reference) lines.push(`Referencia: ${reference}`);
    lines.push(`Nombre: ${value('nombre')}`);
    if (value('telefono')) lines.push(`Teléfono de contacto: ${value('telefono')}`);
    lines.push(`Edad del bebé: ${value('edad')}`, '', '¿Qué me preocupa?', value('motivo'));
    if (value('contexto')) lines.push('', 'Contexto adicional', value('contexto'));
    const caseText = lines.join('\n');

    fallbackCopy.value = caseText;
    if (fallbackMailto?.dataset.email) {
      const subject = `Mi consulta ${reference}`.trim();
      // Los enlaces de correo muy largos fallan en algunas aplicaciones: solo se rellena el asunto.
      const body = caseText.length <= 1500 ? `&body=${encodeURIComponent(caseText)}` : '';
      fallbackMailto.href = `mailto:${fallbackMailto.dataset.email}?subject=${encodeURIComponent(subject)}${body}`;
    }
    form.hidden = true;
    fallback.hidden = false;
    fallbackCopy.focus();
    return true;
  };

  fallbackCopyButton?.addEventListener('click', async () => {
    if (!fallbackCopy) return;
    try {
      await navigator.clipboard.writeText(fallbackCopy.value);
      fallbackCopyButton.textContent = 'Copiado';
    } catch {
      fallbackCopy.select();
    }
  });

  consultaForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!consultaMessage || !consultaButton) return;

    consultaButton.disabled = true;
    consultaButton.textContent = 'Enviando…';
    consultaButton.setAttribute('aria-busy', 'true');
    consultaMessage.hidden = true;

    // Sin respuesta (red caída) o con error del servidor, el caso puede no haber llegado.
    let canFallBack = true;
    try {
      const response = await fetch(consultaForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(Object.fromEntries(new FormData(consultaForm))),
      });

      if (!response.ok) {
        // 4xx: hay algo que corregir o el pago no vale; no tiene sentido enviarlo por correo.
        canFallBack = response.status >= 500;
        const result = await response.json().catch(() => ({}));
        throw new Error(result.error || 'No se pudo enviar la consulta. Inténtalo de nuevo.');
      }

      window.location.assign(response.url || '/consulta-mensaje/enviado');
    } catch (error) {
      if (canFallBack && showFallback(consultaForm)) return;
      consultaButton.disabled = false;
      consultaButton.textContent = 'Enviar mi caso';
      consultaButton.removeAttribute('aria-busy');
      consultaMessage.textContent = error instanceof Error
        ? error.message
        : 'No se pudo enviar la consulta. Inténtalo de nuevo.';
      consultaMessage.hidden = false;
      consultaMessage.focus();
    }
  });
</script>

<style>
  .consulta-form {
    padding: var(--spacing-xl) 0;
  }

  .consulta-form__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .consulta-form__header h1 {
    margin-bottom: var(--spacing-sm);
  }

  .consulta-form__subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 550px;
    margin: 0 auto;
  }

  .consulta-form__wrapper {
    max-width: 600px;
    margin: 0 auto;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: var(--spacing-lg);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form__group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form__group label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .form__group input,
  .form__group textarea {
    font-family: var(--font-family);
    font-size: 0.95rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    color: var(--color-text);
    transition: border-color 0.2s ease;
    resize: vertical;
  }

  .form__group input:focus,
  .form__group textarea:focus {
    border-color: var(--color-coral-hover);
  }

  .form__group input::placeholder,
  .form__group textarea::placeholder {
    color: var(--color-text-tertiary);
  }

  .form__group input[type="file"] {
    padding: 0.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .form__help,
  .form__privacy {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    margin-top: 0.25rem;
  }

  .form__privacy {
    line-height: 1.5;
  }

  .form__privacy a {
    text-decoration: underline;
  }

  .consulta-form__ref {
    margin-top: var(--spacing-sm);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .consulta-form__unchecked {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: flex-start;
  }

  .form__group label span,
  .form__group small {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .consulta-fallback {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .form[hidden],
  .consulta-fallback[hidden] {
    display: none;
  }

  .consulta-fallback label {
    font-weight: 500;
    font-size: 0.9rem;
  }

  .consulta-fallback textarea {
    font-family: var(--font-family);
    font-size: 0.9rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-cream);
    color: var(--color-text);
    resize: vertical;
  }

  .consulta-fallback__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .form__message {
    margin: 0;
    padding: var(--spacing-sm);
    border-left: 4px solid var(--color-coral);
    background-color: var(--color-nude);
    color: var(--color-text);
    font-size: 0.85rem;
  }
</style>
