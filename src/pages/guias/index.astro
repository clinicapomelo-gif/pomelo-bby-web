---
import Layout from '../../layouts/Layout.astro';
import {
  formatGuiaCategory,
  formatGuiaKind,
  formatGuiaPrice,
  getGuiaPrice,
  getStripeMode,
  guias,
  isGuiaPurchasable,
  isGuiaVisible,
} from '../../data/guias';

const stripeMode = getStripeMode(import.meta.env.STRIPE_SECRET_KEY);
const visibleGuias = guias
  .filter((guia) => isGuiaVisible(guia, stripeMode))
  .sort((a, b) =>
    Number(a.status !== 'free') - Number(b.status !== 'free') ||
    Number(a.kind !== 'complete') - Number(b.kind !== 'complete') ||
    getGuiaPrice(a, stripeMode) - getGuiaPrice(b, stripeMode),
  );
---

<Layout title="Las guías de Mar" description="Recursos claros, prácticos y basados en evidencia para acompañarte en las dudas del día a día.">
  <section class="tienda">
    <div class="container">
      <header class="page-header">
        <h1>Las <span>guías</span> de Mar</h1>
        <p class="page-header__subtitle">Recursos claros, prácticos y basados en evidencia para acompañarte en las dudas del día a día.</p>
      </header>

      <div class="tienda__grid">
        {visibleGuias.map((guia) => (
          <article class="guia-card">
            <div class="guia-card__body">
              <div class="guia-card__tags">
                <span class={`guia-card__kind guia-card__kind--${guia.kind}`}>
                  <span class="guia-card__kind-icon" aria-hidden="true">{guia.kind === 'complete' ? '★' : 'ϟ'}</span>
                  {formatGuiaKind(guia.kind)}
                </span>
                <span class="guia-card__category">{formatGuiaCategory(guia.category)}</span>
              </div>
              <h2 class="guia-card__title">{guia.title}</h2>
              <p class="guia-card__description">{guia.description}</p>
              <p class="guia-card__facts">
                <span>{guia.pageCount} páginas</span>
                <span>{guia.kind === 'complete' ? 'Ebook' : 'PDF'}</span>
              </p>
            </div>

            <div class="guia-card__footer">
              <div class="guia-card__availability">
                <span class="guia-card__price">
                  {guia.status === 'free' ? 'Gratis' : formatGuiaPrice(getGuiaPrice(guia, stripeMode))}
                </span>
                <span class="guia-card__status">
                  {guia.status === 'free'
                    ? 'Descarga en PDF'
                    : isGuiaPurchasable(guia, stripeMode) ? 'Disponible ahora' : 'Próximamente'}
                </span>
              </div>

              <a href={`/guias/${guia.id}`} class="btn btn--secondary btn--full">Ver guía</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .tienda {
    padding: var(--spacing-xl) 0;
  }

  .page-header h1 span {
    color: var(--color-coral);
  }

  .tienda__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: var(--spacing-md);
    max-width: 1000px;
    margin: 0 auto;
  }

  .guia-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
  }

  .guia-card:focus-within {
    box-shadow: 0 4px 16px rgba(45, 45, 45, 0.08);
  }

  .guia-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--spacing-lg);
  }

  .guia-card__tags {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .guia-card__kind,
  .guia-card__category {
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .guia-card__kind {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0.45rem 0.8rem;
  }

  .guia-card__kind--practical {
    border: 1px solid var(--color-peach);
    color: var(--color-coral-hover);
    background-color: var(--color-nude);
  }

  .guia-card__kind--complete {
    border: 2px solid var(--color-coral);
    color: var(--color-coral-hover);
    background-color: var(--color-white);
  }

  .guia-card__kind-icon {
    color: var(--color-coral);
    font-size: 1rem;
    line-height: 1;
  }

  .guia-card__category {
    padding: 0.25rem 0.65rem;
    color: var(--color-coral-hover);
    background-color: var(--color-peach);
  }

  .guia-card__title {
    margin-bottom: var(--spacing-sm);
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .guia-card__description {
    flex: 1;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .guia-card__facts {
    display: flex;
    gap: var(--spacing-sm);
    margin: var(--spacing-md) 0 0;
    color: var(--color-coral-hover);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .guia-card__facts span + span::before {
    content: '·';
    margin-right: var(--spacing-sm);
    color: var(--color-peach);
  }

  .guia-card__footer {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .guia-card__availability {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
  }

  .guia-card__price {
    color: var(--color-text);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .guia-card__status {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .guia-card .btn--secondary {
    color: var(--color-coral-hover);
  }

  @media (max-width: 480px) {
    .guia-card__body {
      padding: var(--spacing-md);
    }

    .guia-card__footer {
      padding: var(--spacing-md);
    }
  }
</style>
