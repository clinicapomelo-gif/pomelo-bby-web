---
import Layout from '../../layouts/Layout.astro';
import {
  formatGuiaCategory,
  formatGuiaKind,
  formatGuiaPrice,
  getGuiaPrice,
  getBuildStripeMode,
  guias,
  isFreeGuiaDownloadEnabled,
  isGuiaPurchasable,
  isGuiaVisible,
} from '../../data/guias';

export function getStaticPaths() {
  const stripeMode = getBuildStripeMode();
  return guias.filter((guia) => isGuiaVisible(guia, stripeMode)).map((guia) => ({
    params: { id: guia.id },
    props: { guia },
  }));
}

const stripeMode = getBuildStripeMode();
const { guia } = Astro.props;
const canDownloadFree = isFreeGuiaDownloadEnabled(guia);
const canCheckout = isGuiaPurchasable(guia, stripeMode);
const isAvailable = canDownloadFree || canCheckout;
---

<Layout title={guia.title} description={guia.description}>
  <section class="producto">
    <div class="container">
      <a href="/guias" class="producto__back">← Volver a guías</a>

      <div class="producto__grid">
        <div class="producto__info">
          <div class="producto__tags">
            <span class={`producto__kind producto__kind--${guia.kind}`}>
              <span class="producto__kind-icon" aria-hidden="true">{guia.kind === 'complete' ? '★' : '⚡︎'}</span>
              {formatGuiaKind(guia.kind)}
            </span>
            <span class="producto__category">{formatGuiaCategory(guia.category)}</span>
          </div>
          <h1 class="producto__title">{guia.title}</h1>
          <p class="producto__facts">
            {guia.pageCount && <span>{guia.pageCount} páginas</span>}
            <span>{guia.kind === 'complete' ? 'Ebook' : 'PDF'}</span>
          </p>
          <p class="producto__description">{guia.description}</p>

          {guia.benefits && (
            <ul class="producto__benefits" aria-label="Qué encontrarás dentro">
              {guia.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          )}

          <div class="producto__disclaimer">
            <p>Este recurso es orientativo y no sustituye la valoración de un profesional sanitario.</p>
          </div>
        </div>

        <div class="producto__compra">
          <div class="producto__card">
            <p class={`producto__precio${isAvailable ? '' : ' producto__precio--unavailable'}`}>
              {canDownloadFree
                ? 'Gratis'
                : canCheckout ? formatGuiaPrice(getGuiaPrice(guia, stripeMode)) : 'Próximamente'}
            </p>

            {canDownloadFree && (
              <div class="producto__action">
                <p class="producto__entrega">Una guía rápida gratuita para consultar cuando la necesites.</p>
                <a href={guia.leadMagnetUrl} class="btn btn--primary btn--full">
                  Descargar PDF gratis
                </a>
              </div>
            )}

            {canCheckout && (
              <div class="producto__action">
                <p class="producto__entrega">
                  {guia.kind === 'complete'
                    ? 'Recibirás por email este ebook, con un enlace de descarga disponible durante 30 días.'
                    : 'Recibirás por email esta guía rápida en PDF, con un enlace de descarga disponible durante 30 días.'}
                </p>
                <form id="checkout-form" method="POST" action="/api/checkout">
                  <input type="hidden" name="guiaId" value={guia.id} />
                  <button id="btn-comprar" type="submit" class="btn btn--primary btn--full">
                    {guia.kind === 'complete' ? 'Comprar la guía completa' : 'Comprar la guía rápida'}
                  </button>
                </form>
                <ul class="producto__garantias">
                  <li>✓ Pago seguro con Stripe</li>
                  <li>✓ {guia.kind === 'complete' ? 'Ebook descargable' : 'Guía descargable en PDF'}</li>
                  <li>✓ Si pierdes el enlace, escríbeme y revisamos tu compra</li>
                </ul>
              </div>
            )}

            {!canDownloadFree && !canCheckout && (
              <div class="producto__action">
                <p class="producto__entrega">Este recurso todavía se está preparando.</p>
                <span class="btn btn--disabled btn--full" aria-disabled="true">Próximamente</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#checkout-form');
  const button = document.querySelector<HTMLButtonElement>('#btn-comprar');

  if (form && button) {
    const buttonLabel = button.textContent;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.textContent = 'Redirigiendo...';
      button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();

        if (response.ok && data.url) {
          window.location.href = data.url;
          return;
        }

        throw new Error(data.error || 'No se pudo iniciar el pago.');
      } catch (error) {
        button.textContent = buttonLabel;
        button.disabled = false;
        alert(error instanceof Error ? error.message : 'Ha ocurrido un error. Por favor, inténtalo de nuevo.');
      }
    });
  }
</script>

<style>
  .producto {
    padding: var(--spacing-xl) 0;
  }

  .producto__back {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
    transition: color 0.2s ease;
  }

  .producto__back:hover {
    color: var(--color-coral-text);
  }

  .producto__grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .producto__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .producto__kind,
  .producto__category {
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .producto__kind {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0.45rem 0.8rem;
  }

  .producto__kind--practical {
    border: 1px solid var(--color-peach);
    color: var(--color-coral-hover);
    background-color: var(--color-nude);
  }

  .producto__kind--complete {
    border: 2px solid var(--color-coral);
    color: var(--color-coral-hover);
    background-color: var(--color-white);
  }

  .producto__kind-icon {
    color: var(--color-coral);
    font-size: 1rem;
    line-height: 1;
  }

  .producto__kind--complete .producto__kind-icon {
    font-size: 1.2rem;
  }

  .producto__category {
    padding: 0.25rem 0.65rem;
    color: var(--color-coral-hover);
    background-color: var(--color-peach);
  }

  .producto__title {
    font-size: 2rem;
    line-height: 1.25;
    margin-bottom: var(--spacing-md);
  }

  .producto__facts {
    display: flex;
    gap: var(--spacing-sm);
    margin: calc(var(--spacing-md) * -0.5) 0 var(--spacing-md);
    color: var(--color-coral-hover);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .producto__facts span + span::before {
    content: '·';
    margin-right: var(--spacing-sm);
    color: var(--color-peach);
  }

  .producto__description {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-lg);
  }

  .producto__benefits {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: var(--spacing-lg);
  }

  .producto__benefits li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .producto__benefits li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-coral);
    font-weight: 700;
  }

  .producto__disclaimer {
    padding: var(--spacing-md);
    background-color: var(--color-nude);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-coral);
  }

  .producto__disclaimer p {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Card de compra */
  .producto__card {
    position: sticky;
    top: 100px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .producto__precio {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .producto__precio--unavailable {
    font-size: 1.5rem;
  }

  .producto__action {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .producto__entrega {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .btn--disabled {
    background-color: var(--color-border);
    color: var(--color-text-secondary);
    cursor: not-allowed;
  }

  .producto__garantias {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .producto__garantias li {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1024px) {
    .producto__grid {
      grid-template-columns: 1fr;
    }

    .producto__card {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .producto__title {
      font-size: 1.6rem;
    }
  }
</style>
