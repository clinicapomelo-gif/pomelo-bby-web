---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  alimentacion: 'Alimentación',
  'sueño': 'Sueño',
  salud: 'Salud',
  desarrollo: 'Desarrollo',
  crianza: 'Crianza',
};
---

<Layout title="Blog" description="Dudas reales sobre salud infantil y crianza, explicadas con evidencia, claridad y sin dramas.">
  <section class="blog">
    <div class="container">
      <header class="page-header">
        <h1>Blog</h1>
        <p class="page-header__subtitle">Dudas reales sobre salud infantil y crianza, explicadas sin dramas.</p>
      </header>

      <div class="blog__grid">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-card">
            <div class="post-card__meta">
              <span class="post-card__category">{categoryLabels[post.data.category]}</span>
              <time class="post-card__date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </div>
            <h2 class="post-card__title">{post.data.title}</h2>
            <p class="post-card__description">{post.data.description}</p>
            <span class="post-card__link">Leer artículo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog {
    padding: var(--spacing-xl) 0;
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-lg);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    color: var(--color-text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    color: var(--color-text);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .post-card:focus-visible {
    outline-offset: 4px;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .post-card__category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-coral-text);
    background-color: var(--color-peach);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .post-card__date {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .post-card__title {
    color: var(--color-text);
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .post-card__description {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    flex: 1;
  }

  .post-card__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-coral-text);
    margin-top: var(--spacing-sm);
  }

  @media (max-width: 768px) {
    .blog__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
