---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabels: Record<string, string> = {
  alimentacion: 'Alimentación',
  'sueño': 'Sueño',
  salud: 'Salud',
  desarrollo: 'Desarrollo',
  crianza: 'Crianza',
};
---

<Layout title={post.data.title} description={post.data.description} type="article" pubDate={post.data.pubDate} image={post.data.image}>
  <article class="post">
    <div class="container">
      <header class="post__header">
        <div class="post__meta">
          <span class="post__category">{categoryLabels[post.data.category]}</span>
          <time datetime={post.data.pubDate.toISOString()} class="post__date">
            {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__description">{post.data.description}</p>
        <div class="post__author">
          <span>Por <strong>Mar Vall</strong> · Enfermera pediátrica</span>
        </div>
      </header>

      <div class="post__content prose">
        <Content />
      </div>

      <footer class="post__footer">
        <div class="post__tags">
          {post.data.tags.map((tag) => (
            <span class="post__tag">#{tag}</span>
          ))}
        </div>
        <a href="/blog" class="post__back">← Volver al blog</a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .post {
    padding: var(--spacing-xl) 0;
  }

  .post .container {
    max-width: 720px;
  }

  .post__header {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .post__category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-coral);
    background-color: var(--color-peach);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .post__date {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }

  .post__title {
    font-size: 2.2rem;
    line-height: 1.25;
    margin-bottom: var(--spacing-md);
  }

  .post__description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .post__author {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* Estilos del contenido markdown */
  .prose h2 {
    font-size: 1.5rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-peach);
  }

  .prose h3 {
    font-size: 1.15rem;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    color: var(--color-coral);
  }

  .prose p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .prose ul,
  .prose ol {
    list-style: disc;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--spacing-xs);
  }

  .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose a {
    color: var(--color-coral);
    text-decoration: underline;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--spacing-xl) 0;
  }

  .prose em {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post__footer {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .post__tags {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .post__tag {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .post__back {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-coral);
  }

  .post__back:hover {
    color: var(--color-coral-hover);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: 1.75rem;
    }
  }
</style>
