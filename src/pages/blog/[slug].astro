---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabels: Record<string, string> = {
  alimentacion: 'Alimentación',
  'sueño': 'Sueño',
  salud: 'Salud',
  desarrollo: 'Desarrollo',
  crianza: 'Crianza',
};
---

<Layout title={post.data.title} description={post.data.description} type="article" pubDate={post.data.pubDate} image={post.data.image}>
  <article class="post">
    <div class="container">
      <header class="post__header">
        <div class="post__meta">
          <span class="post__category">{categoryLabels[post.data.category]}</span>
          <time datetime={post.data.pubDate.toISOString()} class="post__date">
            {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__description">{post.data.description}</p>
        <div class="post__author">
          <span>Por <strong>Mar Vall</strong> · Enfermera infantil</span>
        </div>
      </header>

      <div class="post__content prose">
        <Content />
      </div>

      <footer class="post__footer">
        <div class="post__tags">
          {post.data.tags.map((tag) => (
            <span class="post__tag">#{tag}</span>
          ))}
        </div>
        <a href="/blog" class="post__back">← Volver al blog</a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .post {
    padding: var(--spacing-xl) 0;
  }

  .post .container {
    max-width: 720px;
  }

  .post__header {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .post__category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-coral-text);
    background-color: var(--color-peach);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .post__date {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
  }

  .post__title {
    font-size: 2.2rem;
    line-height: 1.25;
    margin-bottom: var(--spacing-md);
  }

  .post__description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .post__author {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* El contenido de Astro Markdown necesita selectores globales. */
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--color-peach);
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    color: var(--color-coral-text);
  }

  .prose :global(p) {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .prose :global(ul),
  .prose :global(ol) {
    list-style: disc;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li) {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-coral-text);
    text-decoration: underline;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--spacing-xl) 0;
  }

  .prose :global(em) {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .prose :global(blockquote) {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-md) var(--spacing-lg);
    border-left: 4px solid var(--color-coral);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-nude);
    color: var(--color-text);
    font-size: 1.08rem;
  }

  .prose :global(blockquote p) {
    margin-bottom: var(--spacing-sm);
    color: inherit;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(blockquote strong) {
    font-size: 1.1em;
  }

  .prose :global(.visual-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
    padding: 0;
    list-style: none;
  }

  .prose :global(.visual-list li) {
    margin: 0;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .prose :global(.warning-list),
  .prose :global(.safety-list) {
    grid-template-columns: 1fr;
  }

  .prose :global(.warning-list li),
  .prose :global(.safety-list li) {
    border-color: var(--color-peach);
    background: var(--color-nude);
  }

  .prose :global(.warning-signs) {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-lg);
    border: 2px solid var(--color-peach);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }

  .prose :global(.warning-signs h3) {
    margin-top: 0;
    color: var(--color-coral-hover);
  }

  .prose :global(.warning-signs p:last-child) {
    margin: var(--spacing-md) 0 0;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  .prose :global(.takeaways) {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg);
    border: 2px solid var(--color-peach);
    border-radius: var(--radius-lg);
    background: var(--color-nude);
  }

  .prose :global(.takeaways h2) {
    margin-top: 0;
    color: var(--color-coral-hover);
  }

  .prose :global(.takeaways__final) {
    margin-top: var(--spacing-lg);
    font-size: 1.15rem;
  }

  .prose :global(.takeaways__welcome) {
    margin-bottom: 0;
    color: var(--color-coral-hover);
    font-size: 1.4rem;
    text-align: center;
  }

  .post__footer {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .post__tags {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .post__tag {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }

  .post__back {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-coral-text);
  }

  .post__back:hover {
    color: var(--color-coral-hover);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: 1.75rem;
    }

    .prose :global(.visual-list) {
      grid-template-columns: 1fr;
    }

    .prose :global(.warning-signs),
    .prose :global(.takeaways) {
      padding: var(--spacing-md);
    }
  }
</style>
