---
---

<div class="newsletter-card" aria-labelledby="newsletter-form-title">
  <h2 id="newsletter-form-title">¿Te apuntas?</h2>
  <p class="newsletter-card__intro">Déjame tu nombre y tu correo. Después te pediré que lo confirmes.</p>

  <form method="POST" action="/api/subscribe" class="newsletter-card__form" data-newsletter-form data-friendly-validation novalidate>
    <div class="newsletter-card__honeypot" aria-hidden="true">
      <label for="newsletter-website">No rellenes este campo</label>
      <input id="newsletter-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="newsletter-card__field" data-validation-field>
      <label for="newsletter-nombre">Nombre</label>
      <input
        type="text"
        name="nombre"
        placeholder="Tu nombre"
        id="newsletter-nombre"
        autocomplete="given-name"
        maxlength="100"
        required
        data-error-required="Escribe tu nombre para que pueda personalizar tus correos."
      />
    </div>

    <div class="newsletter-card__field" data-validation-field>
      <label for="newsletter-email">Correo electrónico</label>
      <input
        type="email"
        name="email"
        placeholder="tu@email.com"
        id="newsletter-email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        required
        data-error-required="Escribe tu correo para apuntarte a El Chisme de Mar."
        data-error-invalid="Revisa el correo. Debe tener un formato como nombre@correo.com."
      />
    </div>

    <div class="newsletter-card__privacy-field" data-validation-field>
      <label class="newsletter-card__privacy">
        <input
          id="newsletter-privacy"
          type="checkbox"
          name="privacy"
          required
          data-error-required="Necesito que aceptes la política de privacidad para completar la suscripción."
        />
        <span>Acepto que Piel de Pomelo SLP use mi nombre y email para enviarme El Chisme. Puedo darme de baja cuando quiera. <a href="/proteccion-datos" target="_blank" rel="noopener">Más información y derechos</a>.</span>
      </label>
    </div>

    <button type="submit" class="btn btn--primary newsletter-card__button">Quiero recibir El Chisme</button>
  </form>

  <p class="newsletter-card__message" data-newsletter-message aria-live="polite" tabindex="-1" hidden></p>
  <p class="newsletter-card__note">Cada quince días · Sin spam · Baja fácil</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const message = document.querySelector<HTMLParagraphElement>('[data-newsletter-message]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  window.addEventListener('pageshow', () => {
    if (!form || !message || !button) return;

    form.hidden = false;
    message.hidden = true;
    button.disabled = false;
    button.textContent = 'Quiero recibir El Chisme';
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!message || !button) return;

    button.disabled = true;
    button.textContent = 'Enviando…';
    message.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result.error || 'Algo ha fallado. Inténtalo de nuevo.');
      }

      form.hidden = true;
      message.textContent = '¡Hecho! Revisa tu correo y confirma tu dirección para unirte a El Chisme.';
      message.className = 'newsletter-card__message newsletter-card__message--success';
    } catch (error) {
      button.disabled = false;
      button.textContent = 'Quiero recibir El Chisme';
      message.textContent = error instanceof Error ? error.message : 'Error de conexión. Inténtalo de nuevo.';
      message.className = 'newsletter-card__message newsletter-card__message--error';
    }

    message.hidden = false;
    message.focus();
  });
</script>

<style>
  .newsletter-card {
    padding: clamp(var(--spacing-md), 4vw, var(--spacing-lg));
    background-color: var(--color-nude);
    border: 1px solid var(--color-peach);
    border-top: 4px solid var(--color-coral);
    border-radius: var(--radius-md);
  }

  .newsletter-card h2 {
    margin-bottom: var(--spacing-xs);
    font-size: 1.5rem;
  }

  .newsletter-card__intro {
    margin-bottom: var(--spacing-md);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .newsletter-card__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .newsletter-card__form[hidden] {
    display: none;
  }

  .newsletter-card__field label {
    display: block;
    margin-bottom: var(--spacing-xs);
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .newsletter-card__field input {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newsletter-card__field input:focus {
    border-color: var(--color-coral-hover);
  }

  .newsletter-card__privacy {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
    cursor: pointer;
  }

  .newsletter-card__privacy input {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    margin-top: 0.2rem;
    accent-color: var(--color-coral);
  }

  .newsletter-card__privacy a {
    color: var(--color-coral-text);
    font-weight: 600;
    text-decoration: underline;
  }

  .newsletter-card__button {
    width: 100%;
    min-height: 48px;
  }

  .newsletter-card__button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .newsletter-card__field input:focus-visible,
  .newsletter-card__button:focus-visible,
  .newsletter-card__privacy input:focus-visible,
  .newsletter-card__privacy a:focus-visible {
    outline-color: var(--color-coral-hover);
  }

  .newsletter-card__message {
    margin: var(--spacing-md) 0 0;
    padding: var(--spacing-md);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
  }

  .newsletter-card__message--success {
    border-left: 4px solid var(--color-coral);
    color: var(--color-text);
  }

  .newsletter-card__message--error {
    border-left: 4px solid var(--color-coral);
    color: var(--color-text);
  }

  .newsletter-card__note {
    margin: var(--spacing-md) 0 0;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    text-align: center;
  }

  .newsletter-card__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .newsletter-card {
      padding: var(--spacing-md);
    }

    .newsletter-card__privacy {
      font-size: 0.8rem;
    }
  }
</style>
