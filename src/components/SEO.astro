---
import { createHash } from 'node:crypto';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  canonicalURL?: string;
  noindex?: boolean;
}

const siteURL = Astro.site ?? new URL('https://pomelobaby.es');
const {
  title,
  description,
  image = '/logo-pomelo-bby.jpeg',
  imageAlt = 'pomelo.bby — Enfermería infantil',
  type = 'website',
  pubDate,
  canonicalURL = new URL(Astro.url.pathname, siteURL).toString(),
  noindex = false,
} = Astro.props;
const fullTitle = `${title} | pomelo.bby`;
const imageURL = new URL(image, siteURL).toString();
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: imageURL,
      datePublished: pubDate?.toISOString(),
      author: { '@type': 'Person', name: 'Mar Vall', jobTitle: 'Enfermera' },
      publisher: {
        '@type': 'Organization',
        name: 'Pomelo Baby',
        legalName: 'Piel de Pomelo SLP',
        url: siteURL,
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'pomelo.bby',
      url: siteURL,
      description: 'Enfermería infantil. Tips reales para familias reales.',
      author: { '@type': 'Person', name: 'Mar Vall', jobTitle: 'Enfermera' },
    };
const schemaJson = JSON.stringify(schema).replaceAll('<', '\\u003c');
const schemaHash = createHash('sha256').update(schemaJson).digest('base64');
Astro.csp.insertScriptHash(`sha256-${schemaHash}`);
---

<!-- SEO básico -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="pomelo.bby" />
<meta property="og:locale" content="es_ES" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Fecha de publicación (solo para artículos) -->
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

<!-- Schema JSON-LD -->
<script type="application/ld+json" set:html={schemaJson} />
