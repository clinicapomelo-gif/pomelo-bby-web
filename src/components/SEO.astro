---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  canonicalURL?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = 'pomelo.bby — Enfermería pediátrica',
  type = 'website',
  pubDate,
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteURL = Astro.site ?? 'https://pomelo-bby.vercel.app';
const fullTitle = `${title} | pomelo.bby`;
const imageURL = new URL(image, siteURL).toString();
---

<!-- SEO básico -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="pomelo.bby" />
<meta property="og:locale" content="es_ES" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Fecha de publicación (solo para artículos) -->
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

<!-- Schema JSON-LD -->
{type === 'website' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "pomelo.bby",
    "url": siteURL,
    "description": "Enfermería pediátrica. Tips reales para familias reales.",
    "author": {
      "@type": "Person",
      "name": "Mar Vall Requena",
      "jobTitle": "Enfermera pediátrica"
    }
  })} />
)}

{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": imageURL,
    "datePublished": pubDate?.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Mar Vall Requena",
      "jobTitle": "Enfermera pediátrica"
    },
    "publisher": {
      "@type": "Organization",
      "name": "pomelo.bby",
      "url": siteURL
    }
  })} />
)}
