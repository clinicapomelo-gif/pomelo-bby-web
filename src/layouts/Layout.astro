---
import SEO from '../components/SEO.astro';
import MaintenancePage from '../components/MaintenancePage.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Enfermería infantil. Acompañamiento, guías y consultas para cuidar a tu bebé con calma.',
  image,
  type = 'website',
  pubDate,
  canonicalURL,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const maintenanceBypassPaths = new Set([
  '/consulta-mensaje/enviado',
  '/consulta-mensaje/gracias',
  '/tienda/gracias',
]);
const maintenanceMode = import.meta.env.MAINTENANCE_MODE === 'true' &&
  !maintenanceBypassPaths.has(normalizedPath);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/logo-pomelo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <SEO
      title={maintenanceMode ? 'Estamos preparando la web' : title}
      description={maintenanceMode ? 'Estamos preparando Pomelo Baby. Muy pronto encontrarás información clara sobre salud infantil y crianza.' : description}
      image={image}
      type={maintenanceMode ? 'website' : type}
      pubDate={maintenanceMode ? undefined : pubDate}
      canonicalURL={canonicalURL}
      noindex={maintenanceMode || noindex}
    />
  </head>
  <body>
    {maintenanceMode ? (
      <MaintenancePage />
    ) : (
      <>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class="header">
      <nav class="container nav">
        <a href="/" class="nav__logo" aria-label="Inicio — Pomelo Baby">
          <img src="/logo-pomelo.webp" alt="" width="192" height="192" />
          <span>Pomelo Baby</span>
        </a>
        <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">
          <span class="nav__toggle-bar"></span>
          <span class="nav__toggle-bar"></span>
          <span class="nav__toggle-bar"></span>
        </button>
        <ul class="nav__links" id="nav-links">
          <li><a href="/blog" class={currentPath.startsWith('/blog') ? 'nav__link--active' : ''} aria-current={normalizedPath === '/blog' ? 'page' : undefined}>Blog</a></li>
          <li><a href="/tienda" class={currentPath.startsWith('/tienda') ? 'nav__link--active' : ''} aria-current={normalizedPath === '/tienda' ? 'page' : undefined}>Tienda</a></li>
          <li><a href="/consultas" class={currentPath.startsWith('/consultas') ? 'nav__link--active' : ''} aria-current={normalizedPath === '/consultas' ? 'page' : undefined}>Consultas</a></li>
          <li><a href="/chisme" class={currentPath.startsWith('/chisme') ? 'nav__link--active' : ''} aria-current={normalizedPath === '/chisme' ? 'page' : undefined}>Chisme</a></li>
          <li><a href="/sobre-mi" class={currentPath.startsWith('/sobre-mi') ? 'nav__link--active' : ''} aria-current={normalizedPath === '/sobre-mi' ? 'page' : undefined}>Sobre mí</a></li>
          <li><a href="/contacto" class={currentPath.startsWith('/contacto') ? 'nav__link--active' : ''} aria-current={normalizedPath === '/contacto' ? 'page' : undefined}>Contacto</a></li>
        </ul>
      </nav>
    </header>

    <script>
      const toggle = document.querySelector('.nav__toggle');
      const navLinks = document.querySelector('.nav__links');
      
      toggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('nav__links--open');
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      });

      // Cerrar menú al hacer clic en un enlace
      navLinks?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('nav__links--open');
          toggle?.setAttribute('aria-expanded', 'false');
          toggle?.setAttribute('aria-label', 'Abrir menú');
        });
      });

      type ValidatedField = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

      const clearValidationError = (field: ValidatedField) => {
        const group = field.closest<HTMLElement>('[data-validation-field]');
        group?.classList.remove('is-invalid');
        group?.querySelector('.form-validation-error')?.remove();
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      };

      const validationMessage = (field: ValidatedField) => {
        if (field.validity.typeMismatch) {
          return field.dataset.errorInvalid || 'Revisa este dato antes de continuar.';
        }
        return field.dataset.errorRequired || 'Completa este campo para continuar.';
      };

      const showValidationError = (field: ValidatedField) => {
        const group = field.closest<HTMLElement>('[data-validation-field]');
        if (!group) return;

        clearValidationError(field);
        const error = document.createElement('p');
        error.id = `${field.id || field.name}-error`;
        error.className = 'form-validation-error';
        error.textContent = validationMessage(field);
        group.classList.add('is-invalid');
        group.append(error);
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', error.id);
      };

      document.addEventListener('submit', (event) => {
        if (!(event.target instanceof HTMLFormElement) || !event.target.matches('[data-friendly-validation]')) return;

        const fields = Array.from(event.target.querySelectorAll<ValidatedField>('[required]'));
        const invalidFields = fields.filter((field) => !field.validity.valid);
        fields.forEach(clearValidationError);

        if (invalidFields.length === 0) return;

        event.preventDefault();
        event.stopImmediatePropagation();
        invalidFields.forEach(showValidationError);
        invalidFields[0].focus();
      }, true);

      const clearChangedField = (event: Event) => {
        if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLSelectElement) {
          clearValidationError(event.target);
        }
      };

      document.addEventListener('input', clearChangedField);
      document.addEventListener('change', clearChangedField);
    </script>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Analytics />

    <footer class="footer">
      <div class="container footer__content">
        <div class="footer__brand">
          <img
            class="footer__logo"
            src="/logo-pomelo-bby.webp"
            alt="Pomelo Baby — Criar sin culpa"
            width="640"
            height="640"
            loading="lazy"
          />
          <p class="footer__tagline">Te guio en la salud y crianza de tus hijos.</p>
        </div>
        <div class="footer__social">
          <a href="https://instagram.com/pomelo.bby" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="mailto:hola@pomelobaby.es">hola@pomelobaby.es</a>
        </div>
        <p class="footer__health-note">Los contenidos generales de esta web tienen carácter informativo y educativo, y no sustituyen una valoración sanitaria individualizada. Las consultas ofrecidas son de enfermería y no incluyen diagnóstico médico ni prescripción de tratamientos. No están pensadas para situaciones urgentes: si algo te preocupa de forma inmediata o tu hijo o hija empeora, busca atención sanitaria sin esperar mi respuesta.</p>
        <nav class="footer__legal" aria-label="Enlaces legales">
          <a href="/aviso-legal">Aviso legal</a>
          <span aria-hidden="true">·</span>
          <a href="/proteccion-datos">Privacidad</a>
          <span aria-hidden="true">·</span>
          <a href="/cookies">Cookies</a>
          <span aria-hidden="true">·</span>
          <a href="/condiciones-venta">Condiciones de compra</a>
        </nav>
        <p class="footer__copy">&copy; {new Date().getFullYear()} Piel de Pomelo SLP · Pomelo Baby</p>
      </div>
    </footer>
      </>
    )}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .skip-link {
    position: fixed;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    z-index: 200;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    color: var(--color-coral-text);
    font-weight: 700;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-md);
    padding-bottom: var(--spacing-md);
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .nav__logo:hover {
    color: var(--color-coral-hover);
  }

  .nav__logo img {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
  }

  .nav__links {
    display: flex;
    gap: var(--spacing-lg);
  }

  .nav__links a {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav__links a:hover {
    color: var(--color-coral-hover);
  }

  .nav__link--active {
    color: var(--color-coral-text) !important;
    font-weight: 700 !important;
    text-decoration: underline;
    text-decoration-color: var(--color-coral);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav__toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    transition: all 0.3s ease;
  }

  .footer {
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-xl) 0 var(--spacing-lg);
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    text-align: center;
  }

  .footer__logo {
    width: min(18rem, 80vw);
    height: auto;
  }

  .footer__tagline {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .footer__social {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .footer__social a {
    color: var(--color-coral-text);
    font-weight: 500;
  }

  .footer__health-note {
    max-width: 780px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .footer__legal a {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .footer__legal span {
    color: var(--color-text-tertiary);
  }

  .footer__legal a:hover {
    color: var(--color-coral-hover);
  }

  .footer__copy {
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
  }

  /* Responsive — móvil */
  @media (max-width: 768px) {
    .nav__toggle {
      display: flex;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: var(--spacing-md) 0;
    }

    .nav__links--open {
      display: flex;
    }

    .nav__links li {
      width: 100%;
    }

    .nav__links a {
      display: block;
      padding: var(--spacing-md) var(--spacing-lg);
      font-size: 1rem;
    }

    .nav__links a:hover {
      background-color: var(--color-cream);
    }

    .nav {
      position: relative;
    }
  }
</style>
