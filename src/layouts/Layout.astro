---
import SEO from '../components/SEO.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const {
  title,
  description = 'Enfermería infantil. Acompañamiento, guías y consultas para cuidar a tu bebé con calma.',
  image,
  type = 'website',
  pubDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/logo-pomelo.jpeg" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      pubDate={pubDate}
    />
  </head>
  <body>
    <header class="header">
      <nav class="container nav">
        <a href="/" class="nav__logo" aria-label="Inicio — pomelo.bby">
          <img src="/logo-pomelo.jpeg" alt="" width="1600" height="1600" />
          <span>pomelo.bby</span>
        </a>
        <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">
          <span class="nav__toggle-bar"></span>
          <span class="nav__toggle-bar"></span>
          <span class="nav__toggle-bar"></span>
        </button>
        <ul class="nav__links" id="nav-links">
          <li><a href="/blog" class={currentPath.startsWith('/blog') ? 'nav__link--active' : ''}>Blog</a></li>
          <li><a href="/tienda" class={currentPath.startsWith('/tienda') ? 'nav__link--active' : ''}>Tienda</a></li>
          <li><a href="/consultas" class={currentPath.startsWith('/consultas') ? 'nav__link--active' : ''}>Consultas</a></li>
          <li><a href="/newsletter" class={currentPath.startsWith('/newsletter') ? 'nav__link--active' : ''}>Chisme</a></li>
          <li><a href="/sobre-mi" class={currentPath.startsWith('/sobre-mi') ? 'nav__link--active' : ''}>Sobre mí</a></li>
          <li><a href="/contacto" class={currentPath.startsWith('/contacto') ? 'nav__link--active' : ''}>Contacto</a></li>
        </ul>
      </nav>
    </header>

    <script>
      const toggle = document.querySelector('.nav__toggle');
      const navLinks = document.querySelector('.nav__links');
      
      toggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('nav__links--open');
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      });

      // Cerrar menú al hacer clic en un enlace
      navLinks?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('nav__links--open');
          toggle?.setAttribute('aria-expanded', 'false');
          toggle?.setAttribute('aria-label', 'Abrir menú');
        });
      });
    </script>

    <main>
      <slot />
    </main>

    <Analytics />

    <footer class="footer">
      <div class="container footer__content">
        <div class="footer__brand">
          <img
            class="footer__logo"
            src="/logo-pomelo-bby.jpeg"
            alt="pomelo.bby — Criar sin culpa"
            width="1600"
            height="1600"
            loading="lazy"
          />
          <p class="footer__tagline">Te guio en la salud y crianza de tus hijos.</p>
        </div>
        <div class="footer__social">
          <a href="https://instagram.com/pomelo.bby" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="mailto:hola@pomelobby.com">hola@pomelobby.com</a>
        </div>
        <div class="footer__legal">
          <a href="/aviso-legal">Aviso legal</a>
          <a href="/proteccion-datos">Protección de datos</a>
          <a href="/cookies">Política de cookies</a>
          <a href="/condiciones-venta">Condiciones de venta</a>
        </div>
        <p class="footer__copy">&copy; {new Date().getFullYear()} pomelo.bby</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--spacing-md);
    padding-bottom: var(--spacing-md);
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .nav__logo:hover {
    color: var(--color-coral);
  }

  .nav__logo img {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
  }

  .nav__links {
    display: flex;
    gap: var(--spacing-lg);
  }

  .nav__links a {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav__links a:hover {
    color: var(--color-coral);
  }

  .nav__link--active {
    color: var(--color-coral) !important;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav__toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    transition: all 0.3s ease;
  }

  .footer {
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-xl) 0 var(--spacing-lg);
    margin-top: var(--spacing-xl);
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    text-align: center;
  }

  .footer__logo {
    width: min(18rem, 80vw);
    height: auto;
  }

  .footer__tagline {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .footer__social {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .footer__social a {
    color: var(--color-coral);
    font-weight: 500;
  }

  .footer__legal {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__legal a {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .footer__legal a:hover {
    color: var(--color-coral);
  }

  .footer__copy {
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
  }

  /* Responsive — móvil */
  @media (max-width: 768px) {
    .nav__toggle {
      display: flex;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: var(--spacing-md) 0;
    }

    .nav__links--open {
      display: flex;
    }

    .nav__links li {
      width: 100%;
    }

    .nav__links a {
      display: block;
      padding: var(--spacing-md) var(--spacing-lg);
      font-size: 1rem;
    }

    .nav__links a:hover {
      background-color: var(--color-cream);
    }

    .nav {
      position: relative;
    }
  }
</style>
