# Variables de entorno — Pomelo Baby
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env al repositorio

# ---- Stripe ----
# Obtén estas claves en https://dashboard.stripe.com/apikeys
# Usa las claves de TEST (sk_test_...) hasta que estés listo para producción
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
# Solo para `npm run guide:sync-live`; nunca se despliega ni sustituye STRIPE_SECRET_KEY.
STRIPE_LIVE_SECRET_KEY=sk_live_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_CONSULTA_MENSAJE_PRICE_ID=price_PLACEHOLDER

# ---- Vercel Blob ----
# Se genera automáticamente al activar Blob Storage en el panel de Vercel
BLOB_READ_WRITE_TOKEN=PLACEHOLDER

# ---- Resend (formulario de contacto) ----
# Obtén la API key en https://resend.com/api-keys
RESEND_API_KEY=re_PLACEHOLDER

# ---- URL del sitio ----
# Cambiar por el dominio real cuando esté disponible
SITE_URL=https://pomelo-bby-web.vercel.app

# RESEND
RESEND_NEWSLETTER_SEGMENT_ID: bdc0f792-5386-4e28-b8a6-5536da685b01
RESEND_NEWSLETTER_TOPIC_ID: 3531793c-6d00-48a8-87af-4cb37eaddd2d
