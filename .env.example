# Variables de entorno — pomelo.bby
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env al repositorio

# ---- Stripe ----
# Obtén estas claves en https://dashboard.stripe.com/apikeys
# Usa las claves de TEST (sk_test_...) hasta que estés listo para producción
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# ---- Vercel Blob ----
# Se genera automáticamente al activar Blob Storage en el panel de Vercel
BLOB_READ_WRITE_TOKEN=PLACEHOLDER

# ---- Kit (ConvertKit) ----
# Obtén la API key en https://app.kit.com/account_settings/developer_settings
KIT_API_KEY=PLACEHOLDER
KIT_FORM_ID=PLACEHOLDER

# ---- Resend (formulario de contacto) ----
# Obtén la API key en https://resend.com/api-keys
RESEND_API_KEY=re_PLACEHOLDER

# ---- URL del sitio ----
# Cambiar por el dominio real cuando esté disponible
SITE_URL=https://pomelo-bby-web.vercel.app
