{
  "name": "pomelo-bby",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm test && npm run guides:check && npm run check && astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "check": "astro check",
    "check:domain": "bash scripts/check-domain.sh",
    "guides:check": "node scripts/check-guide-catalog.mjs",
    "guides:test": "node --test scripts/guide-catalog-core.test.mjs",
    "guide:provision": "node scripts/guide-catalog.mjs provision",
    "guide:price": "node scripts/guide-catalog.mjs price",
    "guide:sync-live": "node --env-file-if-exists=.env scripts/sync-live-guide-catalog.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "astro": "^7.2.4",
    "resend": "^6.20.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
